<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:visitz.Models.BOs"
             xmlns:viewModels="clr-namespace:visitz.ViewModels"
             x:Class="visitz.Views.CaseIncidentDetailsPage"
             x:DataType="viewModels:CaseIncidentDetailsViewModel"
             Title="CaseIncidentDetailsPage"
             BackgroundColor="#F3F3F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Frame BackgroundColor="White">
            <VerticalStackLayout>
                <Label Text="{Binding CaseIncident.DisplayName}" FontSize="28"
                FontFamily="BCSansBold"
                TextColor="#131315"
                Padding="0,10,0,0" />

                <Label Text="{Binding CaseIncident.CaseIncidentNumber, StringFormat='Case {0}'}" FontSize="22"
                FontFamily="BCSansBold"
                TextColor="#606062"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>
        </Frame>

        <Grid Grid.Row="1" BackgroundColor="White" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>


            <HorizontalStackLayout Margin="20,20,0,0">
                <Image
                        Source="folder.png" WidthRequest="36" HeightRequest="36" />
                <Label 
                    Text="Case details"
                    FontSize="22"
                    FontFamily="BCSansBold"
                    TextColor="#131315"
                    Margin="12,0,0,0"
                    />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Margin="20,20,0,0">
                <Label Text="Program Service Area" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,0,0"
                />

                <Label Text="{Binding CaseIncident.CaseIncidentType}" FontSize="17"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Margin="20,20,0,0">
                <Label Text="Case Load" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,0,0"
                />

                <Label Text="{Binding CaseIncident.CaseIncidentNumber}" FontSize="17"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3" Margin="20,20,0,0">
                <Label Text="Open date" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,0,0"
                />

                <Label Text="{Binding CaseIncident.CreatedDate}" FontSize="17"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="4" Grid.ColumnSpan="2" Margin="20,20,0,0">
                <Label Text="Case address" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,10,0"
                />

                <Label FontSize="17"
                Text="{Binding CaseIncident.Address}"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="20,20,0,0">
                <Label Text="Case type" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,0,0"
                />

                <Label Text="{Binding CaseIncident.CaseIncidentType}" FontSize="17"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Margin="20,20,0,0">
                <Label Text="Service office" FontSize="15"
                FontFamily="BCSansRegular"
                TextColor="#606062"
                Padding="0,10,0,0"
                />

                <Label Text="{Binding CaseIncident.ServiceOffice}" FontSize="17"
                FontFamily="BCSansRegular"
                TextColor="#131315"
                Margin="0,5,0,0"
                />
            </VerticalStackLayout>

        </Grid>

        <Frame BackgroundColor="White" Grid.Row="3" Margin="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <HorizontalStackLayout>
                    <Image
                            Source="family.png" WidthRequest="36" HeightRequest="36" />
                    <Label 
                        Text="Family information"
                        FontSize="22"
                        FontFamily="BCSansBold"
                        TextColor="#131315"
                        Margin="12,0,0,0"
                        />
                </HorizontalStackLayout>

                <CollectionView
                    ItemsSource="{Binding CaseIncident.FamilyMembers}"
                    SelectionMode="None"
                    Grid.Row="1"
                    Margin="0,20,0,0">
                    <CollectionView.EmptyView>
                        <Grid>
                            <Image
                            Source="file_folder.png" WidthRequest="150" HeightRequest="150" />
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout  Orientation="Vertical" Span="1"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FamilyMember">
                            <VerticalStackLayout Margin="0,10,0,0">
                                <Border  
                            Stroke="#DFDFE1"
                            StrokeThickness="2"
                            Padding="20,20"
                            HorizontalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,4,4"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <VerticalStackLayout HorizontalOptions="Fill">
                                            <HorizontalStackLayout>
                                                <Image Source="user.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"/>

                                                <Label 
                                                    FontSize="17"
                                                    FontFamily="BCSansBold"
                                                    Margin="10,0,0,0"
                                                    TextColor="#131315">

                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                                            <Binding Path="firstName" />
                                                            <Binding Path="middleName" />
                                                            <Binding Path="lastName" />
                                                        </MultiBinding>
                                                    </Label.Text>

                                                </Label>

                                                <Border
                                                    Margin="10,0,0,0"
                                                    Background="#E2CCF8"
                                                    Padding="10,0,10,0"
                                                    HorizontalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Label 
                                                        Text="{Binding Relationship}"
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        TextColor="#5702AF" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout>
                                                <Border
                                                    Margin="0,10,0,0"
                                                    BackgroundColor="White"
                                                    Padding="10,5,10,5"
                                                    HorizontalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>

                                                    <HorizontalStackLayout>
                                                        <Image Source="mobile.png"
                                                       HeightRequest="16"
                                                       WidthRequest="16"/>

                                                        <Label 
                                                            Text="{Binding CellPhone}"
                                                            FontSize="15"
                                                            Margin="5,0,0,0"
                                                            FontFamily="BCSansRegular" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <Border
                                                    Margin="10,10,0,0"
                                                    BackgroundColor="White"
                                                    Padding="10,0,10,0"
                                                    HorizontalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>

                                                    <HorizontalStackLayout VerticalOptions="Center">
                                                        <Image Source="phone.png"
                                                       HeightRequest="16"
                                                       WidthRequest="16"/>

                                                        <Label 
                                                            Text="{Binding HomePhone}"
                                                            FontSize="15"
                                                            Margin="5,0,0,0"
                                                            FontFamily="BCSansRegular" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                            </HorizontalStackLayout>

                                            <Grid Margin="0, 20, 0, 0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>

                                                <HorizontalStackLayout>
                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#606062"
                                                        Text="Birth:"/>

                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#131315"
                                                        Text="{Binding DateOfBirth}"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Grid.Row="1" Margin="0, 10, 0, 0">
                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#606062"
                                                        Text="Aboriginal:"/>

                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#131315"
                                                        Text="{Binding AboriginalOrigin}"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Grid.Column="1">
                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#606062"
                                                        Text="Gender:"/>

                                                    <Label 
                                                        FontSize="17"
                                                        FontFamily="BCSansRegular"
                                                        Margin="10,0,0,0"
                                                        TextColor="#131315"
                                                        Text="{Binding Sex}"/>
                                                </HorizontalStackLayout>

                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Frame>
    </Grid>
</ContentPage>

