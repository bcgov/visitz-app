<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:hestia.Views"
             xmlns:viewmodels="clr-namespace:hestia.ViewModels"
             xmlns:local="clr-namespace:hestia.Services.Localization"
             x:Class="hestia.Views.LandingPage"
             x:DataType="viewmodels:LandingViewModel"
             Title=""
             BackgroundColor="#003366">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
        <Label 
            Text="{local:Localize AppWelcome}"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            TextColor="White"
            FontFamily="BCSansBold"
            FontSize="28" />
    </VerticalStackLayout>
</views:BasePage>

