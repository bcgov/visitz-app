<Project>
	<PropertyGroup>
		<CSharpierVersion>1.3.0</CSharpierVersion>
		<CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>
		<CoverletCollectorVersion>10.0.1</CoverletCollectorVersion>
		<MauiPackageVersion>10.0.100</MauiPackageVersion>
		<NETTestSdkVersion>18.9.0</NETTestSdkVersion>
		<RealmVersion>20.1.0</RealmVersion>
		<SecurityCodeScanVersion>5.6.7</SecurityCodeScanVersion>
		<SharpSourceVersion>1.31.1</SharpSourceVersion>
		<VisitzVersion>3.1.0</VisitzVersion>
		<XUnitRunnerVsVersion>4.0.0</XUnitRunnerVsVersion>
		<XUnitVersion>4.0.0</XUnitVersion>
	</PropertyGroup>

	<!-- If no BuildTypeColor was provided, use our default "developer build" color -->
	<PropertyGroup Condition=" '$(BuildTypeColor)' == '' ">
		<BuildTypeColor>#440066</BuildTypeColor>
	</PropertyGroup>
</Project>
