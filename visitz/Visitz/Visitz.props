<Project>

	<PropertyGroup>
		<CommunityToolkitMvvmVersion>8.4.0</CommunityToolkitMvvmVersion>
		<CoverletCollectorVersion>6.0.2</CoverletCollectorVersion>
		<MauiPackageVersion>9.0.110</MauiPackageVersion>
		<NETTestSdkVersion>17.10.0</NETTestSdkVersion>
		<RealmVersion>12.4.1</RealmVersion>
		<SecurityCodeScanVersion>5.6.7</SecurityCodeScanVersion>
		<SharpSourceVersion>1.27.1</SharpSourceVersion>
		<VisitzVersion>2.9.0</VisitzVersion>
		<XUnitRunnerVsVersion>2.8.2</XUnitRunnerVsVersion>
		<XUnitVersion>2.9.0</XUnitVersion>
	</PropertyGroup>

	<!-- If no BuildTypeColor was provided, use our default "developer build" color -->
	<PropertyGroup Condition=" '$(BuildTypeColor)' == '' ">
		<BuildTypeColor>#440066</BuildTypeColor>
	</PropertyGroup>

</Project>
