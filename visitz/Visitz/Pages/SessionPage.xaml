<pages:VisitzPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:pages="clr-namespace:Visitz.Pages"
    xmlns:viewModels="clr-namespace:Visitz.ViewModels"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Pages.SessionPage"
    x:DataType="viewModels:SessionViewModel"
    Title="Session"
    BackgroundColor="Black"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="False"
    ios:Page.ModalPresentationStyle="{Binding PresentationStyle}">

    <ContentPage.Resources>
        <Style TargetType="Button" Class="GoldBorderButton">
            <Setter Property="BorderColor" Value="{StaticResource BC_Gold}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style TargetType="Button" Class="SessionButtonLayout">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="50,20,50,20" />
            <Setter Property="FontFamily" Value="BCSansBold" />
        </Style>
    </ContentPage.Resources>

    <AbsoluteLayout IgnoreSafeArea="True">
		<views:FeaturedBackgroundUnderlay
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            ImageDisplayOptions="{Binding BgDisplayOptions}" />

		<Grid
            IgnoreSafeArea="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            RowDefinitions="Auto,*,Auto">

			<controls:CloseButton
                Grid.Row="0"
                Margin="16"
                HorizontalOptions="Start"
                IsVisible="{Binding IsAuthorized}"
                IsEnabled="{Binding IsAuthorized}" />
                
            <Label 
                Grid.Row="0"
                Margin="16"
                HorizontalOptions="Center"
                Text="{Binding DisplayName, StringFormat='Hello, {0}.'}"
                IsVisible="{Binding ShowAuthStatusLayout}"
                FontSize="30"
                TextColor="White" />

            <Grid
                Grid.Row="1"
                Padding="16"
                RowDefinitions="*,2*,Auto">
                    
                <Button
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    StyleClass="SessionButtonLayout,GoldBorderButton"
                    Text="{local:Localize Login}"
                    Command="{Binding LoginAsyncCommand}"
                    IsVisible="{Binding ShowLoginLayout}" />

                <Button 
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    StyleClass="SessionButtonLayout,GoldBorderButton"
                    Text="{local:Localize Logout}"
                    Command="{Binding TryLogoutAsyncCommand}"
                    IsVisible="{Binding IsAuthorized}" />

                <Image
                    Grid.Row="0"
                    IsVisible="{Binding IsUnauthorized}"
                    HeightRequest="300"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource 
                            Glyph="{Binding AuthIcon}"
                            FontFamily="MaterialIconsRoundedFilled"
                            Size="200"
                            Color="{Binding AuthColor}" />
                    </Image.Source>
                </Image>

                <Label 
                    Grid.Row="1"
                    FontSize="20"
                    TextColor="White"
                    WidthRequest="600"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    IsVisible="{Binding IsUnauthorized}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span 
                                FontFamily="BCSansBold"
                                Text="{Binding AuthStatus}" />
                            <Span 
                                FontFamily="BCSansBold"
                                TextDecorations="Underline"
                                Text="{Binding MailToUrl}" />
                            <Span 
                                FontFamily="BCSansBold"
                                Text="." />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

                <HorizontalStackLayout 
                    Grid.Row="2"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsUnauthorized}"
                    Spacing="20">

                    <Button 
                        Text="{local:Localize Logout}"
                        Style="{StaticResource SecondaryButtonDark}"
                        StyleClass="SessionButtonLayout"
                        Command="{Binding TryLogoutAsyncCommand}"
                        IsVisible="{Binding IsUnauthorized}" />

                    <Border
                        Stroke="White"
                        StrokeThickness="1"
                        Padding="5,0,5,0"
                        IsVisible="{Binding IsUnauthorized}">
                
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <ImageButton
                            Padding="15"
                            MaximumHeightRequest="60"
                            MaximumWidthRequest="60"
                            BackgroundColor="Transparent"
                            Command="{Binding LoginAsyncCommand}"
                            Aspect="AspectFill">
                            <ImageButton.Source>
                                <FontImageSource 
                                    Glyph="{Static fonticons:MaterialIcons.Refresh}" 
                                    FontFamily="MaterialIconsRoundedFilled"
                                    Color="White"
                                    Size="60"/>
                            </ImageButton.Source>
                        </ImageButton>
                    </Border>

                    <Button 
                        StyleClass="SessionButtonLayout,GoldBorderButton"
                        Text="{local:Localize Request Access}"
                        Command="{Binding RequestAccessAsyncCommand}"
                        IsVisible="{Binding IsUnauthorized}" />

                </HorizontalStackLayout>

            </Grid>

            <HorizontalStackLayout
                Grid.Row="2"
                HorizontalOptions="Center"
                Spacing="30"
                Margin="5">
                <Label 
                    Text="{Binding BuildNumber, StringFormat='Build #{0}'}" 
                    TextColor="White" />

                <Label 
                    Text="{Binding AppVersion, StringFormat='Version {0}'}" 
                    TextColor="White" />
            </HorizontalStackLayout>

			<Label
				Grid.Row="2"
				HorizontalOptions="End"
				Padding="5"
				Text="{local:Localize FeedbackUrlPrompt}"
				TextColor="White"
				TextDecorations="Underline"
				IsVisible="{Binding ShowFeedbackUrl}">
				<Label.GestureRecognizers>
					<TapGestureRecognizer
						Command="{Binding OpenFeedbackUrlCommand}"
						CommandParameter="{Binding FeedbackUrl}" />
				</Label.GestureRecognizers>
			</Label>
		</Grid>

    </AbsoluteLayout>
    
</pages:VisitzPage>
