<pages:VisitzPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Visitz.Pages"
    xmlns:viewModels="clr-namespace:Visitz.ViewModels"
    x:Class="Visitz.Pages.UserSessionPage"
    x:DataType="viewModels:UserSessionViewModel"
    Title="Session"
    BackgroundColor="Black"
    ControlTemplate="{StaticResource VisitzPageWrapper}">
    
    <AbsoluteLayout>
        <Image 
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            Source="" 
            Aspect="AspectFill"
            Opacity=".5"/>

        <Label 
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds=".5,0"
            Text="{Binding DisplayName, StringFormat='Hello, {0}.'}"
            IsVisible="{Binding ShowGreeting}"
            VerticalOptions="Center" 
            FontSize="30"
            Margin="20"
            HorizontalOptions="Center"
            TextColor="White"/>
        
        <Button 
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds=".5,.5"
            FontSize="20"
            BorderColor="{StaticResource BC_Gold}"
            BorderWidth="1"
            Padding="70,30,70,30"
            Text="{Binding SessionActionText}"
            Command="{Binding PerformSessionActionCommand}"/>

        <Label 
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds=".45,1"
            Margin="10"
            Text="{Binding BuildNumber, StringFormat='Build #{0}'}" 
            TextColor="White" />
        
        <Label 
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds=".55,1"
            Margin="10"
            Text="{Binding AppVersion, StringFormat='Version {0}'}" 
            TextColor="White" />
        
        <HorizontalStackLayout
            
            Spacing="30">
            
        </HorizontalStackLayout>
    
    </AbsoluteLayout>
    
</pages:VisitzPage>