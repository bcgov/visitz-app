<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nav="clr-namespace:Visitz.Views.Navigation"
    xmlns:pages="clr-namespace:Visitz.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:Visitz.ViewModels"
    x:Class="Visitz.Pages.RootPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource BuildBarBackgroundColor}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarStyle="LightContent" StatusBarColor="{StaticResource BuildBarBackgroundColor}" />
    </ContentPage.Behaviors>

    <StackLayout Orientation="Vertical">
        <StackLayout 
            Orientation="Horizontal" 
            HorizontalOptions="FillAndExpand" 
            VerticalOptions="FillAndExpand">

            <nav:VerticalNavRailView />

            <BoxView 
                WidthRequest="2"
                Color="{StaticResource BC_Gold}" />

            <StackLayout 
                x:Name="ContentPane" 
                Orientation="Horizontal"
                HorizontalOptions="FillAndExpand" 
                VerticalOptions="FillAndExpand" />

        </StackLayout>

        <BoxView 
            HeightRequest="2"
            Color="{StaticResource BC_Gold}" />

        <nav:HorizontalNavRailView />

    </StackLayout>
    
</ContentPage>