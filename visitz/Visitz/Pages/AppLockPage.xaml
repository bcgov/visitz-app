<?xml version="1.0" encoding="utf-8" ?>
<pages:VisitzPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Visitz.Pages"
    xmlns:viewmodels="clr-namespace:Visitz.ViewModels"
    xmlns:local="clr-namespace:Visitz.Localization"
    x:Class="Visitz.Pages.AppLockPage"
    x:DataType="viewmodels:AppLockViewModel"
    Title=""
    BackgroundColor="{StaticResource Primary}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <VerticalStackLayout 
        VerticalOptions="CenterAndExpand"
        WidthRequest="500"
        Spacing="40">
        
        <Grid HorizontalOptions="Center">
            <Image Source="tilted_rectangle_bg.png" />
            <Image Source="file_folder.png" />
        </Grid>

        <Button 
            Text="{local:Localize DeviceAuthTitle}"
            HorizontalOptions="Center"
            TextColor="{StaticResource Primary}"
            BackgroundColor="{StaticResource Secondary}"
            FontFamily="BCSansBold"
            FontSize="28"
            Clicked="Unlock_Clicked"/>

        <!--There seems to be an issue with WordWrap Label height when in VerticalStackLayouts.
            So for now we'll just hardcode a height, but this really should be fixed with a better
            workaround (or MAUI update). -->
        <Label 
            Text="{local:Localize DeviceAuthReason}"
            HorizontalOptions="FillAndExpand"
            HorizontalTextAlignment="Center"
            TextColor="White"
            FontFamily="BCSansBold"
            FontSize="22"
            LineBreakMode="WordWrap"
            HeightRequest="100"/>

    </VerticalStackLayout>

</pages:VisitzPage>
