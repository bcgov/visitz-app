<?xml version="1.0" encoding="utf-8" ?>
<pages:VisitzPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Visitz.Pages"
    xmlns:viewmodels="clr-namespace:Visitz.ViewModels"
    xmlns:local="clr-namespace:Visitz.Localization"
    x:Class="Visitz.Pages.AppLockPage"
    x:DataType="viewmodels:AppLockViewModel"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="False"
    Title=""
    BackgroundColor="{StaticResource Primary}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <AbsoluteLayout BackgroundColor="Black" IgnoreSafeArea="True">

        <Image
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            Aspect="AspectFill"
            Opacity=".5">
            
            <Image.Source>
                <UriImageSource 
                    Uri="{Binding BackgroundImageUri}" 
                    CacheValidity="30:0:0:0" />
            </Image.Source>
        </Image>


        <StackLayout 
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds=".5,.5"
            Orientation="Vertical"
            WidthRequest="500"
            Spacing="40">

            <Grid HorizontalOptions="Center">
                <Image Source="tilted_rectangle_bg.png" />
                <Image Source="file_folder.png" />
            </Grid>

            <Button 
                Text="{local:Localize DeviceAuthTitle}"
                HorizontalOptions="Center"
                TextColor="{StaticResource Primary}"
                BackgroundColor="{StaticResource Secondary}"
                FontFamily="BCSansBold"
                FontSize="28"
                Clicked="Unlock_Clicked"/>

            <!--There seems to be an issue with WordWrap Label height when in VerticalStackLayouts.
            So for now we'll just hardcode a height, but this really should be fixed with a better
            workaround (or MAUI update). -->
            <Label 
                Text="{local:Localize DeviceAuthReason}"
                HorizontalOptions="FillAndExpand"
                HorizontalTextAlignment="Center"
                TextColor="White"
                FontFamily="BCSansBold"
                FontSize="22"
                LineBreakMode="WordWrap"
                HeightRequest="100"/>

        </StackLayout>
        
    </AbsoluteLayout>

</pages:VisitzPage>
