<?xml version="1.0" encoding="utf-8" ?>
<pages:VisitzPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Visitz.Pages"
             xmlns:viewModels="clr-namespace:Visitz.ViewModels"
             xmlns:models="clr-namespace:Visitz.Models"
             xmlns:views="clr-namespace:Visitz.Views"
             x:Class="Visitz.Pages.NotesPage"
             x:DataType="viewModels:NotesViewModel"
             Title="Notes">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Details"
            Command="{Binding CaseDetailsTappedCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VerticalStackLayout HorizontalOptions="Fill">
            <HorizontalStackLayout>
                <Label 
                Text="{Binding CaseIncident.DisplayName}"
                FontSize="28"
                FontFamily="BCSansBold"
                Padding="0,10,0,0"
                />

                <Label 
                Text="{Binding CaseIncident.CaseIncidentNumber}"
                FontSize="22"
                FontFamily="BCSansRegular"
                Padding="10,10,0,0"
                />
            </HorizontalStackLayout>

            <HorizontalStackLayout
                Spacing="5">
                <views:TagView
                    BackgroundColor="{StaticResource EntityTagBlueBackground}"
                    TextColor="{StaticResource EntityTagBlueText}"
                    Text="{Binding CaseIncident.EntityType}"
                    IconName="folder.png" />

                <views:TagView
                    BackgroundColor="{StaticResource EntitySubtypeTagPurpleBackground}"
                    TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                    Text="{Binding CaseIncident.CaseIncidentType}"
                    IconName="tag_icon.png" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <Label 
                Text="Case notes"
                FontSize="22"
                FontFamily="BCSansBold"
                Margin="0,20,0,0"
                Grid.Row="1"
                />

        <Entry Placeholder="Search by key word"
               HeightRequest="48"
               Margin="0,20,0,0"
               Grid.Row="2"
            />

        <CollectionView
            ItemsSource="{Binding Notes}"
            SelectionMode="None"
            Grid.Row="3"
            Margin="0,20,0,0">
            <CollectionView.EmptyView>
                <Grid>
                    <Image
                        Source="file_folder.png" WidthRequest="150" HeightRequest="150" />
                </Grid>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <GridItemsLayout  Orientation="Vertical" Span="1"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NoteItem">
                    <VerticalStackLayout Margin="0,10,0,0">
                        <Border  
                        Stroke="#DFDFE1"
                        StrokeThickness="2"
                        Padding="20,20"
                        HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4,4,4,4"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <VerticalStackLayout HorizontalOptions="Fill" Grid.Column="0">
                                    <HorizontalStackLayout>
                                        <Image Source="calendar.png"
                                                   HeightRequest="20"
                                                   WidthRequest="20"/>

                                        <Label 
                                                Text="{Binding NotePeriod}"
                                                FontSize="17"
                                                FontFamily="BCSansBold"
                                                Margin="10,0,0,0"
                                                />
                                    </HorizontalStackLayout>

                                    <Label 
                                            Text="{Binding Content}"
                                            FontSize="17"
                                            FontFamily="BCSansRegular"
                                            Padding="0,10,0,0"
                                            LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="CenterAndExpand">
                                    <Image Source="chevron_right" Margin="25,0,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Add note"
                Grid.Row="3"
                WidthRequest="100"
                HeightRequest="60"
                CornerRadius="30"
                VerticalOptions="End"
                HorizontalOptions="End"
                BackgroundColor="#0073E6"
                FontFamily="BCSansRegular"
                FontSize="17">

            <Button.Shadow>
                <Shadow Brush="Black"
                Offset="10,10"
                Radius="30"
                Opacity="0.5" />
            </Button.Shadow>

        </Button>
    </Grid>
</pages:VisitzPage>

