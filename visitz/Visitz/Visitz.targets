<Project 
	InitialTargets="CopyAppSettings;SetAppBuildTypeColor" 
	DefaultTargets="DoAppSettings" 
	xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(DeploymentEnvironment)' != ''">
		<ApplicationIdTemp>$(ApplicationId)-$(DeploymentEnvironment)</ApplicationIdTemp>
		<ApplicationId>$(ApplicationIdTemp)</ApplicationId>

		<ApplicationTitleTemp>$(ApplicationTitle) $(DeploymentEnvironment)</ApplicationTitleTemp>
		<ApplicationTitle>$(ApplicationTitleTemp)</ApplicationTitle>
	</PropertyGroup>

	<UsingTask 
		TaskName="ReplaceFileText" 
		TaskFactory="RoslynCodeTaskFactory" 
		AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

		<ParameterGroup>
			<InputFilename ParameterType="System.String" Required="true" />
			<OutputFilename ParameterType="System.String" Required="true" />
			<MatchExpression ParameterType="System.String" Required="true" />
			<ReplacementText ParameterType="System.String" Required="true" />
		</ParameterGroup>

		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
						File.WriteAllText(
								OutputFilename,
								Regex.Replace(File.ReadAllText(InputFilename), MatchExpression, ReplacementText)
						);
					]]>
			</Code>
		</Task>
	</UsingTask>

	<Target 
		Name="CopyAppSettings" 
		Condition="'$(Configuration)' == 'Release' And '$(UseAppSettings)' == 'true'">

		<Copy 
			SourceFiles="appSettings.json.template"
			DestinationFiles="appSettings.json" />

	</Target>

	<Target 
		Name="DoAppSettings" 
		AfterTargets="CopyAppSettings" 
		Condition="'$(Configuration)' == 'Release' And '$(UseAppSettings)' == 'true'">
		
		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{AuthenticationDomain}}"
			ReplacementText="$(Oidc_AuthenticationDomain)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{ClientId}}"
			ReplacementText="$(Oidc_ClientId)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{RedirectUri}}"
			ReplacementText="$(Oidc_RedirectUri)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{HttpsApiDomain}}"
			ReplacementText="$(Api_HttpsApiDomain)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{MailToAuthorize}}"
			ReplacementText="$(ContactInfo_MailToAuthorize)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{AccessRequestFormUrl}}"
			ReplacementText="$(ContactInfo_AccessRequestFormUrl)" />

		<ReplaceFileText 
			InputFilename="$(ProjectDir)appSettings.json"
			OutputFilename="$(ProjectDir)appSettings.json"
			MatchExpression="{{EnableDebugOptions}}"
			ReplacementText="$(Debug_EnableDebugOptions)" />

	</Target>

	<PropertyGroup>
		<Namespace>
			<Namespace Prefix="dn" Uri="http://schemas.microsoft.com/dotnet/2021/maui" />
			<Namespace Prefix="x" Uri="http://schemas.microsoft.com/winfx/2009/xaml" />
		</Namespace>
		
		<VisitzColorsXamlPath>$(MSBuildProjectDirectory)\Resources\Styles\Colors.xaml</VisitzColorsXamlPath>
	</PropertyGroup>

	<Target 
		Name="SetAppBuildTypeColor"
		Condition="'$(Configuration)' == 'Release'">

		<Message Importance="high" Text="Setting BuildTypeColor '$(BuildTypeColor)' in Colors.xaml" />

		<XmlPoke
			XmlInputPath="$(VisitzColorsXamlPath)"
			Value="$(BuildTypeColor)"
			Query="/dn:ResourceDictionary/dn:Color[@x:Key='BuildBarBackgroundColor']"
			Namespaces="$(Namespace)" />
	</Target>

</Project>
