<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ControlTemplate x:Key="VisitzPageWrapper">
        <Grid
            RowDefinitions="3,*">
            <Line
                Grid.Row="0"
                HeightRequest="3"
                BackgroundColor="{StaticResource BC_Gold}" />

            <ContentPresenter
                Grid.Row="1" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
