                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{AppThemeBinding Light=#22000000, Dark=#22000000}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{AppThemeBinding Light=#44000000, Dark=#44000000}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="BaseLabelStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BC_TextColor}, Dark={StaticResource BC_TextColor}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="BCSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray300}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}"/>

    <Style TargetType="Label" x:Key="DisplayLarge">
        <Setter Property="FontSize" Value="{DynamicResource DisplayLargeFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="DisplayMedium">
        <Setter Property="FontSize" Value="{DynamicResource DisplayMediumFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="DisplaySmall">
        <Setter Property="FontSize" Value="{DynamicResource DisplaySmallFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineLarge">
        <Setter Property="FontSize" Value="{DynamicResource HeadlineLargeFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineMedium">
        <Setter Property="FontSize" Value="{DynamicResource HeadlineMediumFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineSmall">
        <Setter Property="FontSize" Value="{DynamicResource HeadlineSmallFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="TitleLarge">
        <Setter Property="FontSize" Value="{DynamicResource TitleLargeFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="TitleMedium">
        <Setter Property="FontSize" Value="{DynamicResource TitleMediumFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="TitleSmall">
        <Setter Property="FontSize" Value="{DynamicResource TitleSmallFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="BodyLarge">
        <Setter Property="FontSize" Value="{DynamicResource BodyLargeFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="BodyMedium">
        <Setter Property="FontSize" Value="{DynamicResource BodyMediumFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="BodySmall">
        <Setter Property="FontSize" Value="{DynamicResource BodySmallFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="LabelLarge">
        <Setter Property="FontSize" Value="{DynamicResource LabelLargeFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="LabelMedium">
        <Setter Property="FontSize" Value="{DynamicResource LabelMediumFontSize}" />
    </Style>

    <Style TargetType="Label" x:Key="LabelSmall">
        <Setter Property="FontSize" Value="{DynamicResource LabelSmallFontSize}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="SeparatorColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="RefreshControlColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray900}}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray900}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray900}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BC_Background_Light}, Dark={StaticResource BC_Background_Light}}" />
        <Setter Property="FontFamily" Value="BCSansRegular"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray300}}" />
                            <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray300}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
