<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:drafts="clr-namespace:Visitz.Views.Drafts"
    xmlns:effectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:interfaces="clr-namespace:VisitzModel.Models.Interfaces;assembly=VisitzModel"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:tagViews="clr-namespace:Visitz.Views.TagViews"
    x:Class="Visitz.Views.Drafts.DraftsListItem"
    x:DataType="drafts:DraftListItemViewModel"
>
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer
            Command="{Binding Source={RelativeSource
                    AncestorType={x:Type drafts:DraftsListViewModel}},
                    Path=DraftItemSelectedCommand}"
            CommandParameter="{Binding Draft}"
        />
    </ContentView.GestureRecognizers>

    <effectsView:SfEffectsView TouchDownEffects="Ripple">
        <VerticalStackLayout>
            <Grid
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="30, *, Auto"
                ColumnSpacing="{StaticResource DefaultSpacing}"
                Margin="{StaticResource DefaultMargin}"
            >
                <Grid.Resources>
                    <converters:DateTimeShortTimestampConverter x:Key="ShortTimestampConverter" />
                    <converters:BoolNegationConverter x:Key="BoolConverter" />

                    <Style x:Key="Indicator" TargetType="View">
                        <Setter Property="Grid.Row" Value="3" />
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="HorizontalOptions" Value="End" />
                        <Setter Property="VerticalOptions" Value="Center" />
                    </Style>
                </Grid.Resources>

                <Label
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    FontAutoScalingEnabled="False"
                    FontFamily="MaterialIconsRoundedUnfilled"
                    FontSize="24"
                    Text="{Binding IconGlyph}"
                />

                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    VerticalOptions="Center"
                    FontFamily="BCSansBold"
                    Text="{Binding Draft.DraftLocation}"
                />

                <Label
                    Grid.Column="1"
                    Grid.Row="1"
                    VerticalOptions="Center"
                    Text="{Binding Draft.Preview}"
                    MaxLines="1"
                    LineBreakMode="TailTruncation"
                />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Grid.Row="2"
                    VerticalOptions="Center"
                    Spacing="{StaticResource DefaultSpacingHalf}"
                >
                    <Label
                        Text="{local:Localize Modified}"
                        TextColor="{StaticResource BC_TextColor_Lighter}"
                    />

                    <Label
                        Text="{Binding Draft.LastUpdated.LocalDateTime,
                                Converter={StaticResource ShortTimestampConverter}}"
                        TextColor="{StaticResource BC_TextColor_Lighter}"
                    />
                </HorizontalStackLayout>

                <Label
                    Style="{StaticResource Indicator}"
                    FontSize="20"
                    FontFamily="MaterialIconsRoundedUnfilled"
                    Text="{Static icons:MaterialIcons.Download}"
                    IsVisible="{Binding RelatedEntityDownloaded,
                            Converter={StaticResource BoolConverter}}"
                />

                <Label
                    Style="{StaticResource Indicator}"
                    FontSize="20"
                    BackgroundColor="White"
                    FontFamily="MaterialIconsRoundedUnfilled"
                    Text="{Static icons:MaterialIcons.Link_off}"
                    IsVisible="{Binding RelatedEntityAvailable,
                            Converter={StaticResource BoolConverter}}"
                />

                <ActivityIndicator
                    x:Name="DownloadActivity"
                    Style="{StaticResource Indicator}"
                    BackgroundColor="White"
                    HeightRequest="20"
                    WidthRequest="20"
                />

                <tagViews:EntityTypeBadge
                    Grid.Column="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    EntityType="{Binding Draft.RelatedEntityType}"
                    EntitySubtype="{Binding Draft.RelatedEntitySubtype}"
                />

                <ContentView
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    CascadeInputTransparent="True"
                >
                    <BoxView
                        Color="#55ffffff"
                        IsVisible="{Binding RelatedEntityDownloaded,
                                    Converter={StaticResource BoolConverter}}"
                    />
                </ContentView>
            </Grid>

            <BoxView Margin="10,0" HeightRequest="0.5" Color="{StaticResource Gray200}" />
        </VerticalStackLayout>
    </effectsView:SfEffectsView>
</base:BaseContentView>
