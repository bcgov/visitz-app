<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:Visitz.Controls"
	xmlns:converters="clr-namespace:Visitz.Converters"
	xmlns:local="clr-namespace:Visitz.Localization"
	xmlns:draftModels="clr-namespace:VisitzModel.Models.Drafts;assembly=VisitzModel"
	xmlns:viewModels="clr-namespace:Visitz.ViewModels.Drafts"
	xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Drafts.DraftsList"
	x:DataType="viewModels:DraftsListViewModel">

	<views:ViewModelContentView.Resources>
		<Style TargetType="Grid" x:Key="SameWidth">
			<Setter Property="ColumnDefinitions" Value="*,2*,1.3*" />
		</Style>
	</views:ViewModelContentView.Resources>

	<Grid RowDefinitions="Auto,*">

		<controls:TopAppBar
			Style="{StaticResource SameWidth}"
			Grid.Row="0">

			<controls:TopAppBar.Resources>
				<Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
					<Setter Property="FontFamily" Value="BCSansBold" />
					<Setter Property="TextColor" Value="{StaticResource BC_TextColor_Lighter}" />
					<Setter Property="VerticalOptions" Value="End" />
				</Style>
			</controls:TopAppBar.Resources>
				
			<Label
				Grid.Column="0"
				Text="{local:Localize LastModified}" />

			<Label
				Grid.Column="1"
				Text="{local:Localize Preview}" />

			<Label
				Grid.Column="2"
				Text="{local:Localize File}" />
		</controls:TopAppBar>

		<CollectionView
			Grid.Row="1"
			ItemsSource="{Binding DraftItems}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="draftModels:IDraftItem">
					<ContentView>
						<Grid
							Style="{StaticResource SameWidth}"
							ColumnSpacing="8"
							Margin="10">

							<Grid.Resources>
								<converters:DateTimeOffsetThatDayConverter x:Key="ThatDayConverter" />
							</Grid.Resources>
							
							<Label
								Grid.Column="0"
								Text="{Binding LastUpdated, Converter={StaticResource ThatDayConverter}}"
								TextColor="{StaticResource BC_TextColor_Lighter}" />

							<Label
								Grid.Column="1"
								Text="{Binding Preview}"
								MaxLines="3"
								LineBreakMode="HeadTruncation"/>

							<Label
								Grid.Column="2"
								Text="{Binding DraftLocation}" />
						</Grid>
					</ContentView>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>
</views:ViewModelContentView>
