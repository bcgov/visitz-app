<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Visitz.Views.AddNotePlaceholderView"
             xmlns:viewModels="clr-namespace:Visitz.ViewModels"
             xmlns:fonticons="clr-namespace:Visitz.FontIcons"
             x:Name="this">
    <VerticalStackLayout>
        <Border  
            Stroke="#DFDFE1"
            StrokeThickness="2"
            Padding="20,20"
            HorizontalOptions="Fill"
            BindingContext="{x:Reference this}">

            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:NotesViewModel}}, Path=GoToNoteEntryCommand}" />
            </Border.GestureRecognizers>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4,4,4,4" />
            </Border.StrokeShape>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout HorizontalOptions="Fill" Grid.Column="0">
                    <HorizontalStackLayout
                        Spacing="5">
                        <Image
                            HeightRequest="25"
                            WidthRequest="25"
                            IsVisible="{Binding ShowNotePeriod}"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource 
                                Glyph="{Static fonticons:MaterialIcons.Calendar_month}"
                                FontFamily="MaterialIconsRoundedUnfilled"
                                Color="#0073E6" />
                            </Image.Source>
                        </Image>

                        <Label 
                            Text="{Binding NotePeriod}"
                            FontSize="17"
                            FontFamily="BCSansBold"
                            IsVisible="{Binding ShowNotePeriod}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Label 
                            Text="{Binding ContentText}"
                            MaxLines="3"
                            FontSize="17"
                            FontFamily="BCSansRegular"
                            Padding="0,10,0,0"
                            LineBreakMode="WordWrap" />

                        <Label 
                            Text="Add note"
                            TextColor="{StaticResource SkyBlueText}"
                            MaxLines="3"
                            FontSize="17"
                            FontFamily="BCSansRegular"
                            Padding="0,10,0,0"
                            LineBreakMode="WordWrap" />

                        <Image
                            Source="add_note.png"
                            WidthRequest="16"
                            HeightRequest="16"
                            Margin="0,10,0,0" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="CenterAndExpand">
                    <Image Source="chevron_right" Margin="25,0,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </VerticalStackLayout>
</ContentView>

