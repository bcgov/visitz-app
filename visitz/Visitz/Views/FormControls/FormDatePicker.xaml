<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.FormControls.FormDatePicker"
    x:DataType="formControls:FormDatePicker"
    x:Name="self"
>
    <VerticalStackLayout BindingContext="{Reference self}">
        <Label Text="{Binding FieldName}" VerticalOptions="Center" HorizontalOptions="Start" />

        <DatePicker x:Name="DatePickerView" Date="{Binding Date}" />
    </VerticalStackLayout>
</ContentView>
