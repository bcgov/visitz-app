<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.FormControls.FormEntry"
    x:DataType="formctls:FormEntry"
    x:Name="this">
    
    <Grid
        BindingContext="{Reference this}"
        RowDefinitions="*,*,*"
        ColumnDefinitions="*,*">
        
        <Label 
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="{Binding FieldName}"
            HorizontalOptions="Start" />

        <Entry
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Text="{Binding Text}"/>

        <Label 
            Grid.Row="2"
            Grid.Column="0"
            HorizontalOptions="Start"
            Text="{Binding LeadingSupportingText}"
            Style="{StaticResource LabelSmall}" />

        <Label 
            Grid.Row="2"
            Grid.Column="1"
            HorizontalOptions="End"
            Text="{Binding TrailingSupportingText}"
            Style="{StaticResource LabelSmall}" />
    </Grid>
    
</ContentView>
