<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.FormControls.FormPromptAnswerField"
    x:DataType="formctls:FormPromptAnswerField"
    x:Name="this"
>
    <ContentView.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </ContentView.Resources>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <VerticalStackLayout
                BindingContext="{Reference this}"
                RadioButtonGroup.GroupName="{Binding RadioButtonGroupName}"
            >
                <Label Text="{Binding QuestionPrompt}" HorizontalOptions="Start" />

                <RadioButton
                    IsChecked="{Binding YesChecked}"
                    Content="Yes"
                    CheckedChanged="RadioButton_CheckedChanged"
                    HorizontalOptions="Start"
                    Margin="0,0,0,-5"
                    Value="{x:Static formctls:YesNoAnswer.Yes}"
                    IsEnabled="{Binding IsReadOnly, Converter={StaticResource BoolNegationConverter}}"
                />

                <RadioButton
                    IsChecked="{Binding NoChecked}"
                    Content="No"
                    CheckedChanged="RadioButton_CheckedChanged"
                    HorizontalOptions="Start"
                    Value="{x:Static formctls:YesNoAnswer.No}"
                    IsEnabled="{Binding IsReadOnly, Converter={StaticResource BoolNegationConverter}}"
                />

                <ContentPresenter />

                <formctls:FormEntry
                    FieldName="{Binding AnswerContextExplanation}"
                    Text="{Binding AnswerContext}"
                    IsReadOnly="{Binding IsReadOnly}"
                />
            </VerticalStackLayout>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
