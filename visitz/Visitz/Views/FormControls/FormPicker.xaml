<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.FormControls.FormPicker"
    x:DataType="formControls:FormPicker"
    x:Name="self"
>
    <VerticalStackLayout BindingContext="{Reference self}">
        <Label Text="{Binding FieldName}" VerticalOptions="Center" HorizontalOptions="Start" />

        <Picker
            x:Name="PickerView"
            ItemsSource="{Binding ItemsSource}"
            SelectedItem="{Binding SelectedItem}"
        />
    </VerticalStackLayout>
</ContentView>
