<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.FormControls.FormRadioButton"
    x:DataType="formctls:FormRadioButton"
    x:Name="this">
    
    <Grid ColumnDefinitions="Auto,*" BindingContext="{Reference this}">
        <RadioButton 
            x:Name="RadioButton"
            Grid.Column="0"
            VerticalOptions="Center"
            IsChecked="{Binding IsChecked}"
            GroupName="{Binding GroupName}"
            Value="{Binding Value}" />

        <Label 
            Grid.Column="1"
            Text="{Binding Text}"
            VerticalOptions="Fill"
            VerticalTextAlignment="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
    
</ContentView>
