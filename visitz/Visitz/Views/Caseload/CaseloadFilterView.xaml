<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:caseload="clr-namespace:Visitz.Views.Caseload"
    xmlns:models="clr-namespace:Visitz.Models"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Caseload.CaseloadFilterView"
    x:DataType="caseload:CaseloadFilterViewModel">
    
    <StackLayout Spacing="10" Orientation="Horizontal">
        <Image
            WidthRequest="20"
            HeightRequest="20"
            VerticalOptions="Start">
            <Image.Source>
                <FontImageSource 
                    Glyph="{Static icons:MaterialIcons.Filter_alt}"
                    FontFamily="MaterialIconsRoundedUnfilled"
                    Color="Black"
                    Size="80"/>
            </Image.Source>
        </Image>

        <FlexLayout
            HorizontalOptions="StartAndExpand"
            Wrap="Wrap"
            Direction="Row"
            AlignItems="Center"
            AlignContent="Center"
            JustifyContent="Start"
            BindableLayout.ItemsSource="{Binding FilterItems}">
            
            <BindableLayout.EmptyView>
                <Label 
                    TextColor="LightSlateGray"
                    Text="caseload filters" />
            </BindableLayout.EmptyView>
            
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:FilterItem">
                    <caseload:FilterItemView />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
        
    </StackLayout>
    
</views:ViewModelContentView>
