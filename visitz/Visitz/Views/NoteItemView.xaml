<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Visitz.Models"
             x:Class="Visitz.Views.NoteItemView"
             x:DataType="models:NoteItem">
    
    <VerticalStackLayout Margin="0,10,0,0">
        <Border  
            Stroke="#DFDFE1"
            StrokeThickness="2"
            Padding="20,20"
            HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4,4,4,4" />
            </Border.StrokeShape>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout HorizontalOptions="Fill" Grid.Column="0">
                    <HorizontalStackLayout>
                        <Image Source="calendar.png"
                            HeightRequest="20"
                            WidthRequest="20" />

                        <Label 
                            Text="{Binding NotePeriod}"
                            FontSize="17"
                            FontFamily="BCSansBold"
                            Margin="10,0,0,0" />
                    </HorizontalStackLayout>

                    <Label 
                        Text="{Binding Content}"
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Padding="0,10,0,0"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="CenterAndExpand">
                    <Image Source="chevron_right" Margin="25,0,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
