<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:root="clr-namespace:Visitz.Views.Root"
    xmlns:nav="clr-namespace:Visitz.Views.Navigation"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Root.NavDrawerContentView"
    x:DataType="root:NavDrawerContentViewModel">
    
    <Grid
        RowDefinitions="*, Auto">
        
        <views:FeaturedBackgroundUnderlay
            Grid.RowSpan="3"
            ImageDisplayOptions="TextReadable" />

        <ScrollView
            Grid.Row="0"
            VerticalOptions="Fill">

            <VerticalStackLayout>
                
                <VerticalStackLayout>

                    <VerticalStackLayout.Margin>
                        <Thickness
                            Top="15" />
                    </VerticalStackLayout.Margin>

                    <VerticalStackLayout.Behaviors>
                        <behaviors:SelectionLayoutBehavior
                            ItemsSource="{Binding NavRailViewModel.NavigationItems}"
                            SelectedItem="{Binding NavRailViewModel.SelectedNavItem}"
                            StickySelection="True" />
                    </VerticalStackLayout.Behaviors>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <nav:NavDrawerItemView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView
                    Color="White"
                    HorizontalOptions="Fill"
                    HeightRequest="1"
                    Margin="28,16"/>

                <VerticalStackLayout>
                    <nav:NavDrawerItemView
                        BindingContext="{Binding CollectionNoticeNavItem}">
                        <nav:NavDrawerItemView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding UserViewModel.OpenCollectionNoticeCommand}"/>
                        </nav:NavDrawerItemView.GestureRecognizers>   
                    </nav:NavDrawerItemView>

                    <nav:NavDrawerItemView
                        BindingContext="{Binding FeedbackNavItem}">
                        <nav:NavDrawerItemView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding UserViewModel.OpenFeedbackUrlCommand}" />
                        </nav:NavDrawerItemView.GestureRecognizers>
                    </nav:NavDrawerItemView>
                    
                    <nav:NavDrawerItemView
                        BindingContext="{Binding LogoutNavItem}">
                        <nav:NavDrawerItemView.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding UserViewModel.TryLogoutCommand}" />
                        </nav:NavDrawerItemView.GestureRecognizers>
                    </nav:NavDrawerItemView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout
            Grid.Row="2"
            Margin="10"
            Spacing="30"
            HorizontalOptions="Center">
            <Label
                Text="{Binding UserViewModel.BuildNumber, StringFormat='Build #{0}'}"
                TextColor="White" />

            <Label
                Text="{Binding UserViewModel.AppVersion, StringFormat='Version {0}'}"
                TextColor="White" />
        </HorizontalStackLayout>

    </Grid>
</base:ViewModelContentView>
