<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:root="clr-namespace:Visitz.Views.Root"
    xmlns:nav="clr-namespace:Visitz.Views.Navigation"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Root.NavDrawerContentView"
    x:DataType="root:NavDrawerContentViewModel"
    x:TypeArguments="root:NavDrawerContentViewModel"
>
    <Grid RowDefinitions="*, Auto">
        <views:FeaturedBackgroundUnderlay Grid.RowSpan="2" ImageDisplayOptions="TextReadable" />

        <ScrollView Grid.Row="0" VerticalOptions="Fill">
            <VerticalStackLayout>
                <nav:NavDrawerItemView
                    x:Name="CollectionNoticeItem"
                    BindingContext="{Binding CollectionNoticeNavItem}"
                />

                <nav:NavDrawerItemView
                    x:Name="FeedbackItem"
                    BindingContext="{Binding FeedbackNavItem}"
                />

                <nav:NavDrawerItemView
                    x:Name="LogoutItem"
                    BindingContext="{Binding LogoutNavItem}"
                />
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Margin="10" Spacing="30" HorizontalOptions="Center">
            <Label
                Text="{Binding UserViewModel.BuildNumber, StringFormat='Build #{0}'}"
                TextColor="White"
            />

            <Label
                Text="{Binding UserViewModel.AppVersion, StringFormat='Version {0}'}"
                TextColor="White"
            />
        </HorizontalStackLayout>
    </Grid>
</base:ViewModelContentView>
