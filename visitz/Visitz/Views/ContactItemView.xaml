<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tag_behaviors="clr-namespace:Visitz.Behaviors.Tags"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:models="clr-namespace:Visitz.Models"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    x:Class="Visitz.Views.ContactItemView"
    x:DataType="models:FamilyMember">

    <Border
        x:Name="ContainerBorder"
        Stroke="#DFDFE1"
        StrokeThickness="1"
        Padding="20">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4,4,4,4"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                <Image
                    HeightRequest="28"
                    WidthRequest="28"
                    VerticalOptions="Center"
                    Margin="0,0,-5,0">
                    <Image.Source>
                        <FontImageSource 
                            Glyph="{Static fonticons:MaterialIcons.Person}"
                            FontFamily="MaterialIconsRoundedUnfilled"
                            Color="#5702AF" />
                    </Image.Source>
                </Image>

                <Label 
                    Text="{Binding FullDisplayName}"
                    FontSize="17"
                    FontFamily="BCSansBold"
                    VerticalOptions="Center" />

                <views:TagView VerticalOptions="Center">
                    <views:TagView.Behaviors>
                        <tag_behaviors:ContactRelationshipTagBehavior />
                    </views:TagView.Behaviors>
                </views:TagView>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="PhoneRow" Spacing="5">
                <views:TagView
                    x:Name="CellPhoneTagView"
                    BackgroundColor="Transparent"
                    Text="{Binding CellPhone}"
                    BorderColor="{StaticResource PurpleTagBorder}"
                    VerticalOptions="Center">
                    
                    <views:TagView.ImageSource>
                        <FontImageSource 
                            Glyph="{Static fonticons:MaterialIcons.Phone_iphone}"
                            FontFamily="MaterialIconsRoundedUnfilled"
                            Color="{StaticResource BC_TextColor}" />
                    </views:TagView.ImageSource>
                    
                </views:TagView>

                <views:TagView
                    x:Name="HomePhoneTagView"
                    BackgroundColor="Transparent"
                    Text="{Binding HomePhone}"
                    BorderColor="{StaticResource PurpleTagBorder}"
                    VerticalOptions="Center">

                    <views:TagView.ImageSource>
                        <FontImageSource 
                            Glyph="{Static fonticons:MaterialIcons.Home}"
                            FontFamily="MaterialIconsRoundedUnfilled"
                            Color="{StaticResource BC_TextColor}" />
                    </views:TagView.ImageSource>

                </views:TagView>
            </HorizontalStackLayout>

            <Grid BackgroundColor="Transparent" RowSpacing="10">
                
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- TODO: Make a Control template for FormItemView to render side-by-side and replace these stacklayouts with it -->
                <HorizontalStackLayout Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Date of birth:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding DateOfBirth}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="1" Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Indigenous:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding AboriginalOrigin}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Gender:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding Sex}"/>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
