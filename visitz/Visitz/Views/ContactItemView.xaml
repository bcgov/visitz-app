<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Visitz.Views"
             xmlns:models="clr-namespace:Visitz.Models"
             x:Class="Visitz.Views.ContactItemView"
             x:DataType="models:FamilyMember">

    <VerticalStackLayout>
        <Border
            x:Name="ContainerBorder"
            Stroke="#DFDFE1"
            StrokeThickness="2"
            Padding="20"
            HorizontalOptions="Fill" >

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4,4,4,4"/>
            </Border.StrokeShape>

            <Grid
                BackgroundColor="Transparent">
                <VerticalStackLayout
                    HorizontalOptions="Fill"
                    BackgroundColor="Transparent">
                    <HorizontalStackLayout
                        Spacing="10">
                        <Image Source="user.png"
                            HeightRequest="20"
                            WidthRequest="20"/>

                        <Label 
                            Text="{Binding FullDisplayName}"
                            FontSize="17"
                            FontFamily="BCSansBold" />

                        <views:TagView
                            x:Name="RelationshipTagView"
                            BackgroundColor="{StaticResource EntitySubtypeTagPurpleBackground}"
                            TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                            Text="{Binding Relationship}"
                            IconName=""
                            BorderColor="Transparent" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout
                        Spacing="5">
                        <views:TagView
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                            Text="{Binding CellPhone}"
                            IconName="mobile.png"
                            BorderColor="{StaticResource PurpleTagBorder}" />

                        <views:TagView
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                            Text="{Binding HomePhone}"
                            IconName="phone.png"
                            BorderColor="{StaticResource PurpleTagBorder}" />
                    </HorizontalStackLayout>

                    <Grid
                        Margin="0, 20, 0, 0"
                        BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <HorizontalStackLayout>
                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                TextColor="{StaticResource BC_InputControlsTextColor}"
                                Text="Birth:"/>

                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                Text="{Binding DateOfBirth}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Margin="0, 10, 0, 0">
                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                TextColor="{StaticResource BC_InputControlsTextColor}"
                                Text="Aboriginal:"/>

                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                Text="{Binding AboriginalOrigin}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1">
                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                TextColor="{StaticResource BC_InputControlsTextColor}"
                                Text="Gender:"/>

                            <Label 
                                FontSize="17"
                                FontFamily="BCSansRegular"
                                Margin="10,0,0,0"
                                Text="{Binding Sex}"/>
                        </HorizontalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>

</ContentView>
