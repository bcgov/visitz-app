<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:models="clr-namespace:Visitz.Models"
    x:Class="Visitz.Views.ContactItemView"
    x:DataType="models:FamilyMember">

    <Border
        x:Name="ContainerBorder"
        Stroke="#DFDFE1"
        StrokeThickness="2"
        Padding="20">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4,4,4,4"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                <Image 
                    Source="user.png"
                    HeightRequest="20"
                    WidthRequest="20"
                    VerticalOptions="Center"/>

                <Label 
                    Text="{Binding FullDisplayName}"
                    FontSize="17"
                    FontFamily="BCSansBold"
                    VerticalOptions="Center" />

                <views:TagView
                    x:Name="RelationshipTagView"
                    BackgroundColor="{StaticResource EntitySubtypeTagPurpleBackground}"
                    TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                    Text="{Binding Relationship}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="PhoneRow" Spacing="5">
                <views:TagView
                    x:Name="CellPhoneTagView"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                    Text="{Binding CellPhone}"
                    IconName="mobile.png"
                    BorderColor="{StaticResource PurpleTagBorder}"
                    VerticalOptions="Center" />

                <views:TagView
                    x:Name="HomePhoneTagView"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource EntitySubtypeTagPurpleText}"
                    Text="{Binding HomePhone}"
                    IconName="phone.png"
                    BorderColor="{StaticResource PurpleTagBorder}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid BackgroundColor="Transparent" RowSpacing="10">
                
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- TODO: Make a Control template for FormItemView to render side-by-side and replace these stacklayouts with it -->
                <HorizontalStackLayout Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Birth:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding DateOfBirth}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="1" Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Aboriginal:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding AboriginalOrigin}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        TextColor="{StaticResource BC_InputControlsTextColor}"
                        Text="Gender:"/>

                    <Label 
                        FontSize="17"
                        FontFamily="BCSansRegular"
                        Text="{Binding Sex}"/>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
