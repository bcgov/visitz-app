<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:selView="clr-namespace:Visitz.Views.SelectionView"
    x:Class="Visitz.Views.SelectionView.VerticalSelectionView"
    x:DataType="selView:VerticalSelectionView"
    x:Name="this">

    <StackLayout
        x:Name="MainStack"
        BindingContext="{Reference this}"
        Orientation="Vertical"
        BindableLayout.ItemsSource="{Binding ItemsSource}"
        BindableLayout.ItemTemplate="{Binding ItemTemplate}"/>
    
</views:BaseContentView>
