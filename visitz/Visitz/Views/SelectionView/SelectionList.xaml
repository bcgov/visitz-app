<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:BaseContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:selView="clr-namespace:Visitz.Views.SelectionView"
    x:Class="Visitz.Views.SelectionView.SelectionList"
    x:DataType="selView:SelectionList"
    x:Name="this">

    <StackLayout
        x:Name="MainStack"
        BindingContext="{Reference this}"
        Orientation="{Binding Orientation, TargetNullValue=Vertical}"
        ChildAdded="MainStack_ChildAdded"
        ChildRemoved="MainStack_ChildRemoved"
        BindableLayout.ItemsSource="{Binding ItemsSource}"
        BindableLayout.ItemTemplate="{Binding ItemTemplate}"/>
    
</baseClasses:BaseContentView>
