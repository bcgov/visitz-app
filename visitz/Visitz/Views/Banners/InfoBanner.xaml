<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:banners="clr-namespace:Visitz.Views.Banners"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Banners.InfoBanner"
    x:DataType="banners:InfoBanner"
    x:Name="this"
>
    <Border
        x:Name="Border"
        BindingContext="{Reference this}"
        HorizontalOptions="Fill"
        StrokeShape="RoundRectangle 4"
        StrokeThickness="2"
    >
        <Border.Padding>
            <Thickness
                Left="{StaticResource DefaultPadding}"
                Right="{StaticResource DefaultPadding}"
                Top="{StaticResource DefaultPaddingHalf}"
                Bottom="{StaticResource DefaultPaddingHalf}"
            />
        </Border.Padding>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource DefaultSpacing}">
            <Label
                x:Name="IconLabel"
                Grid.Column="0"
                VerticalOptions="Start"
                FontFamily="MaterialIconsRoundedFilled"
                FontSize="24"
            />

            <Label
                Grid.Column="1"
                FontFamily="BCSansBold"
                FontSize="{StaticResource BodyMediumFontSize}"
                Text="{Binding Text}"
                VerticalOptions="Center"
            />
        </Grid>
    </Border>
</ContentView>
