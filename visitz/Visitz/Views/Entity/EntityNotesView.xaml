<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entity="clr-namespace:Visitz.Views.Entity"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:models="clr-namespace:Visitz.Models"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Entity.EntityNotesView"
    x:DataType="entity:EntityNotesViewModel">

    <StackLayout Orientation="Vertical">
        
        <AbsoluteLayout VerticalOptions="FillAndExpand">
            <VerticalStackLayout 
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.5,0.5"
                IsVisible="{Binding IsNotesEmtpy}">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer 
                        Command="{Binding AddNoteCommand}" 
                        CommandParameter="{Binding .}"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label 
                    HorizontalOptions="Center"
                    FontSize="200"
                    TextColor="#919197"
                    Text="{Static icons:MaterialIcons.Note_stack}"
                    FontFamily="MaterialIconsRoundedUnfilled" />

                <!-- TapGestureRecognizer isn't working in this instance, so hide the prompt for now.
                    TODO: Get taps working here so we can show this prompt. -->
                <HorizontalStackLayout 
                    IsVisible="False"
                    HorizontalOptions="Center"
                    Spacing="5">
                    <Label
                        VerticalOptions="Center"
                        FontSize="16"
                        TextColor="{StaticResource SkyBlueText}"
                        Text="Add notes" />

                    <Label 
                        VerticalOptions="Center"
                        FontFamily="MaterialIconsRoundedUnfilled"
                        FontSize="28"
                        TextColor="{StaticResource SkyBlueText}"
                        Text="{Static icons:MaterialIcons.Add_notes}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <CollectionView
                AbsoluteLayout.LayoutFlags="All"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                x:Name="NotesCollectionView"
                Loaded="NotesCollectionView_Loaded"
                IsGrouped="True"
                ItemsSource="{Binding Notes}"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:NoteItemGroup">
                        
                        <!-- Fonts in Windows seem to have extra padding -->
                        <ContentView 
                            Padding="{OnPlatform WinUI='0', Default='10'}">
                            
                            <Label
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center"
                                Text="{Binding Name}" 
                                FontFamily="BCSansBold" 
                                Padding="0"
                                FontSize="20" />
                        </ContentView>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:NoteItem">
                        <ContentView>
                            <Label
                                Margin="10,0,10,0"
                                Text="{Binding Content}" />
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </AbsoluteLayout>

        <BoxView 
            Color="{StaticResource SeparatorColor}"
            HeightRequest="0.5" />

        <Grid 
            Padding="10"
            RowDefinitions="Auto"
            ColumnDefinitions="Auto,*,Auto">
            
            <!-- TODO: Unhide this search button once notes search is implemented. -->
            <Button 
                IsVisible="False"
                Grid.Column="0"
                Style="{StaticResource Minimal}"
                FontSize="20"
                FontFamily="MaterialIconsRoundedUnfilled"
                Text="{Static icons:MaterialIcons.Search}" />

            <Button 
                Grid.Column="2"
                CornerRadius="20"
                Text="{local:Localize AddNotes}"
                Command="{Binding AddNoteCommand}">
                <Button.ImageSource>
                    <FontImageSource 
                        Glyph="{Static icons:MaterialIcons.Edit}"
                        FontFamily="MaterialIconsRoundedUnfilled"
                        Size="20"/>
                </Button.ImageSource>
            </Button>
        </Grid>
        
    </StackLayout>
</views:ViewModelContentView>
