<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:safetyModels="clr-namespace:Visitz.Models.SafetyAssess"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:entity="clr-namespace:Visitz.Views.Entity"
    x:Class="Visitz.Views.Entity.EntitySafetyAssessView"
    x:DataType="entity:EntitySafetyAssessViewModel">

    <views:ViewModelContentView.Resources>
        <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineHeight" Value="1.7" />
        </Style>

        <Style x:Key="MidsectionHeader" TargetType="Label" BasedOn="{StaticResource BodyLarge}">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="LineHeight" Value="1.7" />
        </Style>

        <Style x:Key="AssessmentHeader" TargetType="Label" BasedOn="{StaticResource TitleMedium}">
            <Setter Property="BackgroundColor" Value="AliceBlue"/>
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="-10,0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="FontFamily" Value="BCSansBold" />
        </Style>

        <Style TargetType="formctls:FormPromptAnswerField">
            <Setter Property="AnswerContextExplanation" Value="Comments (if clarification or rationale for the rating is needed)" />
        </Style>

        <Style TargetType="VerticalStackLayout" Class="FormVsl">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Spacing" Value="10" />
        </Style>

        <Style TargetType="Border">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Stroke" Value="{StaticResource BC_TextColor}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </views:ViewModelContentView.Resources>

    <ScrollView>
        <Grid
            RowDefinitions="*,*,*,*,*,*,*"
            RowSpacing="10"
            ColumnDefinitions="2*,*"
            ColumnSpacing="10"
            Padding="10">

            <VerticalStackLayout 
                Grid.Row="0" 
                Grid.Column="0" 
                StyleClass="FormVsl" 
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type entity:EntitySafetyAssessViewModel}}, Path=SafetyAssessment.FactorInfluence}"
                x:DataType="safetyModels:FactorInfluence">
                
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize FactorsInfluencingChildVuln}" />

                <formctls:FormCheckBox
                    Text="{local:Localize AgeUpToFive}"
                    IsChecked="{Binding AgeUptoFive}" />
                    
                <formctls:FormCheckBox
                    Text="{local:Localize MedicalMentalDisorder}"
                    IsChecked="{Binding MedicalMentalDisorder}" />
                    
                <formctls:FormCheckBox
                    Text="{local:Localize NotReadilyAccessible}"
                    IsChecked="{Binding NotReadilyAccessible}" />
                    
                <formctls:FormCheckBox
                    Text="{local:Localize DiminishedMental}"
                    IsChecked="{Binding DiminishedMental}" />
                    
                <formctls:FormCheckBox
                    Text="{local:Localize DiminishedPhysical}"
                    IsChecked="{Binding DiminishedPhysical}" />
            </VerticalStackLayout>

            <VerticalStackLayout 
                Grid.Row="1" 
                Grid.Column="0" 
                StyleClass="FormVsl"
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type entity:EntitySafetyAssessViewModel}}, Path=SafetyAssessment.SafetyFactors}"
                x:DataType="safetyModels:SafetyFactors">
                
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize SafetyFactors}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor1}">

                    <Border>
                        <VerticalStackLayout>
                            <formctls:FormCheckBox Text="{local:Localize SafetyFactor1SeriousInjury}" />
                            <formctls:FormCheckBox Text="{local:Localize SafetyFactor1ProviderFears}" />
                            <formctls:FormCheckBox Text="{local:Localize SafetyFactor1ThreatOfHarm}" />
                            <formctls:FormCheckBox Text="{local:Localize SafetyFactor1Discipline}" />
                            <formctls:FormCheckBox Text="{local:Localize SafetyFactor1Substance}" />
                        </VerticalStackLayout>
                    </Border>
                </formctls:FormPromptAnswerField>

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor2}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor3}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor4}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor5}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor6}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor7}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor8}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor9}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor10}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor11}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor12}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor13}" />

                <formctls:FormPromptAnswerField 
                    QuestionPrompt="{local:Localize SafetyFactor14}"
                    AnswerContextExplanation="{local:Localize SafetyFactor14Context}"/>

            </VerticalStackLayout>

            <VerticalStackLayout 
                Grid.Row="2" 
                Grid.Column="0" 
                StyleClass="FormVsl"
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type entity:EntitySafetyAssessViewModel}}, Path=SafetyAssessment.ProtectiveCapacity}"
                x:DataType="safetyModels:ProtectiveCapacity">
                
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize ProtectiveCapacities}" />

                <Label Text="{local:Localize MarkAllThatApply}" />

                
                <Label
                    Style="{StaticResource MidsectionHeader}"
                    Text="{local:Localize Child}" />

                <formctls:FormCheckBox 
                    Text="{local:Localize CapacityChildCognitive}" />

                
                <Label
                    Style="{StaticResource MidsectionHeader}"
                    Text="{local:Localize ParentCareProvider}" />

                <formctls:FormCheckBox Text="{local:Localize CapacityParentCognitive }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentWillingness }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentResources }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentSupportive }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentProtect }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentAccept }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentRelationship }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentAware }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityParentProbSolving }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityNoProCapPresent }" />
                <formctls:FormCheckBox Text="{local:Localize CapacityComments1 }" />

                <formctls:FormEntry FieldNameIsVisible="False" />

                <formctls:FormEntry FieldName="{local:Localize CapacityComments2 }"/>

            </VerticalStackLayout>

            <VerticalStackLayout 
                Grid.Row="3" 
                Grid.Column="0" 
                StyleClass="FormVsl"
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type entity:EntitySafetyAssessViewModel}}, Path=SafetyAssessment.SafetyInterventions}"
                x:DataType="safetyModels:SafetyInterventions">
                
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize SafetyInterventions}" />

                <Grid 
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">
                    <Label 
                        VerticalOptions="Center"
                        FontFamily="MaterialIconsRoundedUnfilled"
                        FontSize="{StaticResource HeadlineLargeFontSize}"
                        TextColor="{StaticResource Semantic_Warning_LargeText}"
                        Text="{Static icons:MaterialIcons.Warning}" />
                    
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        Text="{local:Localize SafetyInterventionPrompt}" />
                </Grid>

                <Label Text="{local:Localize SafetyInterventionDescription}" />

                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention1}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention2}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention3}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention4}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention5}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention6}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention7}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention8}" />
                <formctls:FormEntry FieldNameIsVisible="False" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention9}" />
                <formctls:FormCheckBox Text="{local:Localize SafetyIntervention10}" />

            </VerticalStackLayout>

            <VerticalStackLayout 
                Grid.Row="4" 
                Grid.Column="0" 
                StyleClass="FormVsl"
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type entity:EntitySafetyAssessViewModel}}, Path=SafetyAssessment.SafetyDecisions}"
                x:DataType="safetyModels:SafetyDecisions">
                
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize SafetyDecision}" />

                <Label Text="{local:Localize SafetyDecisionPrompt}" />

                <Border>
                    <VerticalStackLayout Spacing="10">
                        <formctls:FormRadioButton 
                            GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}" 
                            Value="1" 
                            Text="{local:Localize SafetyDecision1_NoSafetyFactors}" />
                        <formctls:FormRadioButton 
                            GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}"
                            Value="2" 
                            Text="{local:Localize SafetyDecision2_SafeInterventions}" />
                        <formctls:FormRadioButton 
                            GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}"
                            Value="3" 
                            Text="{local:Localize SafetyDecision3_UnsafeSafetyFactors}" />
                        
                        <VerticalStackLayout Spacing="10" Margin="30,0,0,0">
                            <formctls:FormRadioButton 
                                GroupName="{Static entity:EntitySafetyAssessViewModel.WhichChildrenPlaced}"
                                Value="1" 
                                Text="{local:Localize SafetyDecision_AllYouth}" />
                            <formctls:FormRadioButton 
                                GroupName="{Static entity:EntitySafetyAssessViewModel.WhichChildrenPlaced}"
                                Value="2" 
                                Text="{local:Localize SafetyDecision_SelectedYouth}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label 
                    Style="{StaticResource MidsectionHeader}"
                    Text="{local:Localize SafetyPlan}" />

                <formctls:FormEntry 
                    FieldName="{local:Localize SafetyPlanDescription}"
                    Placeholder="{local:Localize SafetyPlan}"/>

                <Label 
                    Style="{StaticResource MidsectionHeader}"
                    Text="{local:Localize Narrative}" />

                <formctls:FormEntry 
                    FieldName="{local:Localize NarrativeDescription}"
                    Placeholder="{local:Localize Narrative}"/>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="5" Grid.Column="0" StyleClass="FormVsl">
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize ChildrenInOutCare}" />

            </VerticalStackLayout>
            
            <VerticalStackLayout 
                Grid.Row="6" 
                Grid.Column="0"
                StyleClass="FormVsl">
                <Label
                    Style="{StaticResource AssessmentHeader}"
                    Text="{local:Localize SafetyAssessmentMetadata}" />

                <formctls:FormEntry
                    x:Name="IncidentNumberEntry"
                    FieldName="{local:Localize IncidentNumber}"
                    Text="{Binding CaseloadItem.CaseIncidentNumber}" />
                
                <formctls:FormEntry
                    x:Name="WorkerIdEntry"
                    FieldName="{local:Localize WorkerId}"
                    Text="{Binding WorkerId}" />
                
                <formctls:FormEntry
                    x:Name="FamilyNameEntry"
                    FieldName="{local:Localize FamilyName}" 
                    Text="{Binding CaseloadItem.DisplayName}" />
                
                <formctls:FormEntry
                    x:Name="DateOfAssessmentEntry"
                    FieldName="{local:Localize DateOfAssessment}" 
                    Text="" />
                
                <formctls:FormEntry
                    x:Name="OperationEntry"
                    FieldName="{local:Localize SafetyAssessmentOperation}" 
                    Text="{local:Localize Insert}"
                    IsEnabled="False" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
    
</views:ViewModelContentView>
