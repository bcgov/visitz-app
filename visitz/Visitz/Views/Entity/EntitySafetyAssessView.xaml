<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:models="clr-namespace:Visitz.Models"
    xmlns:safetyModels="clr-namespace:Visitz.Models.SafetyAssess"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:entity="clr-namespace:Visitz.Views.Entity"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Visitz.Views.Entity.EntitySafetyAssessView"
    x:DataType="entity:EntitySafetyAssessViewModel">

    <views:ViewModelContentView.Resources>
        <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineHeight" Value="1.7" />
        </Style>

        <Style x:Key="MidsectionHeader" TargetType="Label" BasedOn="{StaticResource BodyLarge}">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="LineHeight" Value="1.7" />
        </Style>

        <Style x:Key="AssessmentHeader" TargetType="Label" BasedOn="{StaticResource TitleMedium}">
            <Setter Property="BackgroundColor" Value="AliceBlue"/>
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="-10,0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="FontFamily" Value="BCSansBold" />
        </Style>

        <Style TargetType="formctls:FormPromptAnswerField">
            <Setter Property="AnswerContextExplanation" Value="Comments (if clarification or rationale for the rating is needed)" />
        </Style>

        <Style TargetType="VerticalStackLayout" Class="FormVsl">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Spacing" Value="10" />
        </Style>

        <Style TargetType="Border">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Stroke" Value="{StaticResource BC_TextColor}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>

        <ResourceDictionary>
            <toolkit:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter" />
            <converters:YesNoAnswerToBoolConverter x:Key="YesNoToBool" />
        </ResourceDictionary>
    </views:ViewModelContentView.Resources>

    <Grid RowDefinitions="*,0.5,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout StyleClass="FormVsl"
                MaximumWidthRequest="800">

                <VerticalStackLayout StyleClass="FormVsl">

                    <Label 
                        Margin="0,0,0,-10"
                        Text="{local:Localize DateOfAssessment}" />

                    <DatePicker 
                        Margin="0,0"
                        Date="{Binding Assessment.DateOfAssessment, Converter={StaticResource DateTimeOffsetConverter}}"/>

                    <Label 
                        Margin="0,0,0,-10"
                        Text="{local:Localize FamilyName}" />
                    <Picker 
                        SelectedItem="{Binding Assessment.FamilyName}"
                        ItemsSource="{Binding FamilyNames}" />

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize FactorsInfluencingChildVuln}" />

                    <Label Text="{local:Localize InabilityProtectSelfMarkAll}" />

                    <formctls:FormCheckBox
                        Text="{local:Localize FactorVuln_AgeUpToFive}"
                        IsChecked="{Binding Influence.AgeUptoFive}" />
                    
                    <formctls:FormCheckBox
                        Text="{local:Localize FactorVuln_MedicalMentalDisorder}"
                        IsChecked="{Binding Influence.MedicalMentalDisorder}" />
                    
                    <formctls:FormCheckBox
                        Text="{local:Localize FactorVuln_NotReadilyAccessible}"
                        IsChecked="{Binding Influence.NotReadilyAccessible}" />
                    
                    <formctls:FormCheckBox
                        Text="{local:Localize FactorVuln_DiminishedMental}"
                        IsChecked="{Binding Influence.DiminishedMental}" />
                    
                    <formctls:FormCheckBox
                        Text="{local:Localize FactorVuln_DiminishedPhysical}"
                        IsChecked="{Binding Influence.DiminishedPhysical}" />
                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize SafetyFactors}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor1_PhysicalHarm}"
                        Answer="{Binding Factors.PhysicalHarm, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtClarification}">

                        <Border>
                            <VerticalStackLayout>
                            
                                <formctls:FormCheckBox
                                    Text="{local:Localize SafetyFactor1_SeriousInjury}"
                                    IsChecked="{Binding Factors.SeriousInjuryAbuse}" />
                                <formctls:FormCheckBox
                                    Text="{local:Localize SafetyFactor1_ProviderFears}"
                                    IsChecked="{Binding Factors.FearsMaltreatChild}" />
                                <formctls:FormCheckBox
                                    Text="{local:Localize SafetyFactor1_ThreatOfHarm}"
                                    IsChecked="{Binding Factors.ThreatAgainstChild}" />
                                <formctls:FormCheckBox
                                    Text="{local:Localize SafetyFactor1_Discipline}"
                                    IsChecked="{Binding Factors.ExcessiveForce}" />
                                <formctls:FormCheckBox
                                    Text="{local:Localize SafetyFactor1_Substance}"
                                    IsChecked="{Binding Factors.SubsExposedInfant}" />
                            </VerticalStackLayout>
                        </Border>
                    </formctls:FormPromptAnswerField>

                    <formctls:FormPromptAnswerField
                        QuestionPrompt="{local:Localize SafetyFactor2_CurrentCircumstances}" 
                        Answer="{Binding Factors.CurrentCircumstances, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtCircumstances}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor3_SexAbuse}" 
                        Answer="{Binding Factors.SexAbuse, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtAbuse}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor4_UnableToProtect}" 
                        Answer="{Binding Factors.UnableToProtect, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtProtect}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor5_InjuryExplanation}" 
                        Answer="{Binding Factors.InjuryExplanation, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtExplanation}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor6_RefuseAccess}" 
                        Answer="{Binding Factors.RefuseAccess, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtAccess}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor7_ImmediateNeeds}" 
                        Answer="{Binding Factors.ImmediateNeeds, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtNeeds}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor8_PhysicalCondition}" 
                        Answer="{Binding Factors.PhysicalCondition, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtCondition}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor9_CurrentAbuse}" 
                        Answer="{Binding Factors.CurrentAbuse, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtCurrent}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor10_PartnerViolence}" 
                        Answer="{Binding Factors.PartnerViolence, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtViolence}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor11_PredominantlyNegative}" 
                        Answer="{Binding Factors.PredominantlyNegative, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtNegative}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor12_EmotionalStability}" 
                        Answer="{Binding Factors.EmotionalStability, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtEmotional}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor13_ChildFearful}" 
                        Answer="{Binding Factors.ChildFearful, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtFearful}" />

                    <formctls:FormPromptAnswerField 
                        QuestionPrompt="{local:Localize SafetyFactor14_OtherFactors}"
                        AnswerContextExplanation="{local:Localize SafetyFactor14_Context}"
                        Answer="{Binding Factors.OtherFactors, Converter={StaticResource YesNoToBool}}"
                        AnswerContext="{Binding Factors.CmtOtherFactors}" />

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize ProtectiveCapacities}" />

                    <Label Text="{local:Localize MarkAllThatApply}" />

                
                    <Label
                        Style="{StaticResource MidsectionHeader}"
                        Text="{local:Localize Child}" />

                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ChildCognitive}"
                        Text="{local:Localize ProtectiveCapacity_ChildCognitive}" />

                
                    <Label
                        Style="{StaticResource MidsectionHeader}"
                        Text="{local:Localize ParentCareProvider}" />

                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentCognitive}"
                        Text="{local:Localize ProtectiveCapacity_ParentCognitive }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentWillingness}"
                        Text="{local:Localize ProtectiveCapacity_ParentWillingness }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentResources}"
                        Text="{local:Localize ProtectiveCapacity_ParentResources }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentSupportive}"
                        Text="{local:Localize ProtectiveCapacity_ParentSupportive }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentProtect}"
                        Text="{local:Localize ProtectiveCapacity_ParentProtect }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentAccept}"
                        Text="{local:Localize ProtectiveCapacity_ParentAccept }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentRelationship}"
                        Text="{local:Localize ProtectiveCapacity_ParentRelationship }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentAware}"
                        Text="{local:Localize ProtectiveCapacity_ParentAware }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.ParentProbSolving}"
                        Text="{local:Localize ProtectiveCapacity_ParentProbSolving }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.NoProCapPresent}"
                        Text="{local:Localize ProtectiveCapacity_NoProCapPresent }" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Capacity.CapacitiesOther}"
                        Text="{local:Localize ProtectiveCapacity_Comments1 }" />

                    <formctls:FormEntry
                        FieldNameIsVisible="False"
                        Text="{Binding Capacity.CmtProtectiveCapacity01}" />

                    <formctls:FormEntry 
                        FieldName="{local:Localize ProtectiveCapacity_Comments2 }"
                        Text="{Binding Capacity.CmtProtectiveCapacity02}"/>

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize SafetyInterventions}" />

                    <Grid 
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10"
                        Margin="0,10">
                        <Label 
                            Grid.Column="0"
                            LineHeight="1.0"
                            VerticalOptions="Center"
                            FontFamily="MaterialIconsRoundedUnfilled"
                            FontSize="{StaticResource HeadlineLargeFontSize}"
                            TextColor="{StaticResource Semantic_Warning_LargeText}"
                            Text="{Static icons:MaterialIcons.Warning}" />

                        <Label
                            Grid.Column="1"
                            LineHeight="1.0"
                            VerticalOptions="Center"
                            Text="{local:Localize SafetyIntervention_Prompt}" />
                    </Grid>

                    <Label Text="{local:Localize SafetyIntervention_Description}" />

                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.DirectIntervention}"
                        Text="{local:Localize SafetyIntervention1_DirectIntervention}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.UseOfIndividuals}"
                        Text="{local:Localize SafetyIntervention2_UseOfIndividuals}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.UseCommAgencies}"
                        Text="{local:Localize SafetyIntervention3_UseCommAgencies}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.ProtectVictim}"
                        Text="{local:Localize SafetyIntervention4_ProtectVictim}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.LeaveHome}"
                        Text="{local:Localize SafetyIntervention5_LeaveHome}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.NonOffendingParent}"
                        Text="{local:Localize SafetyIntervention6_NonOffendingParent}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.LegalIntPlanned}"
                        Text="{local:Localize SafetyIntervention7_LegalIntPlanned}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.OtherSafetyInterventions}"
                        Text="{local:Localize SafetyIntervention8_OtherSafetyInterventions}" />
                    <formctls:FormEntry 
                        FieldNameIsVisible="False"
                        Text="{Binding Interventions.CmtSafetyInterventions}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.ChildOutsideHome}"
                        Text="{local:Localize SafetyIntervention9_ChildOutsideHome}" />
                    <formctls:FormCheckBox 
                        IsChecked="{Binding Interventions.ChildRemoved}"
                        Text="{local:Localize SafetyIntervention10_ChildRemoved}" />

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize SafetyDecision}" />

                    <Label Text="{local:Localize SafetyDecision_Prompt}" />

                    <Border>
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout 
                                Spacing="10"
                                RadioButtonGroup.GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}"
                                RadioButtonGroup.SelectedValue="{Binding Decisions.Decision}">
                                <formctls:FormRadioButton
                                    Value="{Static safetyModels:SafetyDecisionOption.Safe}"
                                    GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}" 
                                    Text="{local:Localize SafetyDecision1_NoSafetyFactors}" />
                                <formctls:FormRadioButton
                                    Value="{Static safetyModels:SafetyDecisionOption.SafeWithInterventions}"
                                    GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}"
                                    Text="{local:Localize SafetyDecision2_SafeInterventions}" />
                                <formctls:FormRadioButton
                                    Value="{Static safetyModels:SafetyDecisionOption.Unsafe}"
                                    GroupName="{Static entity:EntitySafetyAssessViewModel.SafetyDecisionGroup}"
                                    Text="{local:Localize SafetyDecision3_UnsafeSafetyFactors}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout 
                                Spacing="10"
                                Margin="30,0,0,0"
                                RadioButtonGroup.GroupName="{Static entity:EntitySafetyAssessViewModel.WhichChildrenPlaced}"
                                RadioButtonGroup.SelectedValue="{Binding Decisions.DecisionUnsafe}">
                                <formctls:FormRadioButton 
                                    GroupName="{Static entity:EntitySafetyAssessViewModel.WhichChildrenPlaced}"
                                    Value="{Static safetyModels:SafetyDecisions.AllChildrenPlaced}"
                                    Text="{local:Localize SafetyDecision_AllYouth}" />
                                <formctls:FormRadioButton 
                                    GroupName="{Static entity:EntitySafetyAssessViewModel.WhichChildrenPlaced}"
                                    Value="{Static safetyModels:SafetyDecisions.SomeChildrenPlaced}"
                                    Text="{local:Localize SafetyDecision_SelectedYouth}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label 
                        Style="{StaticResource MidsectionHeader}"
                        Text="{local:Localize SafetyPlan}" />

                    <formctls:FormEntry 
                        FieldName="{local:Localize SafetyPlanDescription}"
                        Placeholder="{local:Localize SafetyPlan}"
                        Text="{Binding Decisions.Comments}"/>

                    <Label 
                        Style="{StaticResource MidsectionHeader}"
                        Text="{local:Localize Narrative}" />

                    <formctls:FormEntry 
                        FieldName="{local:Localize NarrativeDescription}"
                        Placeholder="{local:Localize Narrative}"
                        Text="{Binding Decisions.Narrative}"/>

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">
                    <Label
                        Style="{StaticResource AssessmentHeader}"
                        Text="{local:Localize ChildrenInOutCare}" />

                    <CollectionView
                        ItemsSource="{Binding ChildrenInOutCare}"
                        SelectionMode="Multiple"
                        SelectedItems="{Binding SelectedChildren}">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FamilyMember">
                                <HorizontalStackLayout>

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter TargetName="NameLabel" Property="BackgroundColor" Value="{StaticResource ItemSelectedColor}" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource ItemSelectedColor}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                
                                    <Label
                                        x:Name="NameLabel"
                                        LineHeight="1.0"
                                        BackgroundColor="White"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center"
                                        Padding="10"
                                        Text="{Binding FullDisplayName}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

                <VerticalStackLayout StyleClass="FormVsl">

                    <Label
                        Style="{StaticResource Decisions.AssessmentHeader}"
                        Text="{local:Localize SendToTeamLeader}" />

                    <formctls:FormCheckBox
                        IsChecked="{Binding Decisions.ReadyFinalize}"
                        Text="{local:Localize ReadyToFinalize}" />

                    <formctls:FormEntry
                        FieldName="{local:Localize SocialWorkerName}"
                        Text="{Binding Assessment.WorkerId}" />

                    <Label 
                        Margin="0,0,0,-10"
                        Text="{local:Localize ReadyToFinalizeDate}" />

                    <DatePicker Date="{Binding Decisions.ReadyFinalizeDate, Converter={StaticResource DateTimeOffsetConverter}}" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="1" Color="{StaticResource SeparatorColor}" />
        
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Padding="10">
            <Button
                Grid.Column="1"
                Text="Discard draft"
                Style="{StaticResource SecondaryButtonLight}"
                Command="{Binding ResetCommand}" />

            <Button
                Grid.Column="2"
                Text="{local:Localize PublishToIcm}"
                Command="{Binding PublishCommand}" />
        </Grid>
    </Grid>
</views:ViewModelContentView>
