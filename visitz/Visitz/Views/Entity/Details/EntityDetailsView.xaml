<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:details="clr-namespace:Visitz.Views.Entity.Details"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:models="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Entity.Details.EntityDetailsView"
    x:DataType="details:EntityDetailsViewModel"
    x:TypeArguments="details:EntityDetailsViewModel"
>
    <ScrollView>
        <FlexLayout
            AlignItems="Start"
            AlignContent="Start"
            Direction="Row"
            JustifyContent="Start"
            Position="Absolute"
            Wrap="Wrap"
            Padding="{StaticResource DefaultPaddingHalf}"
        >
            <FlexLayout.Resources>
                <Style TargetType="Border">
                    <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
                    <Setter Property="Margin" Value="{StaticResource DefaultMarginHalf}" />
                    <Setter Property="Padding" Value="{StaticResource DefaultPadding}" />
                    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                    <Setter Property="StrokeThickness" Value="0" />
                    <Setter Property="WidthRequest" Value="{OnIdiom Phone=300, Default=400}" />
                </Style>
                <Style TargetType="VerticalStackLayout">
                    <Setter Property="Spacing" Value="{StaticResource DefaultSpacing}" />
                </Style>
            </FlexLayout.Resources>

            <Border>
                <VerticalStackLayout>
                    <Label FontFamily="BCSansBold" Text="{local:Localize RecordInformation}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecordInfoItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="formControls:InfoItem">
                                <formControls:InfoItemView />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout>
                    <Label FontFamily="BCSansBold" Text="{local:Localize KeyPlayerInformation}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ContactInfoItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="formControls:InfoItem">
                                <formControls:InfoItemView />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </FlexLayout>
    </ScrollView>
</baseClasses:IcmRecordContentView>
