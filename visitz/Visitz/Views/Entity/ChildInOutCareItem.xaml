<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entity="clr-namespace:Visitz.Views.Entity"
    xmlns:models="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
    x:Class="Visitz.Views.Entity.ChildInOutCareItem"
    x:DataType="models:FamilyMember">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState Name="Normal">
                    <VisualState.Setters>
                        <Setter TargetName="ItemCheckBox" Property="CheckBox.IsChecked" Value="False" />
                        <Setter Property="BackgroundColor" Value="White" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState Name="Selected">
                    <VisualState.Setters>
                        <Setter TargetName="ItemCheckBox" Property="CheckBox.IsChecked" Value="True" />
                        <Setter Property="BackgroundColor" Value="White" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>

    <Grid
        ColumnSpacing="5"
        RowSpacing="5">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Static entity:ChildInOutCareItem.CheckBoxGridLength}" />
            <ColumnDefinition Width="{Static entity:ChildInOutCareItem.LastNameGridLength}" />
            <ColumnDefinition Width="{Static entity:ChildInOutCareItem.FirstNameGridLength}" />
            <ColumnDefinition Width="{Static entity:ChildInOutCareItem.DateOfBirthGridLength}" />
            <ColumnDefinition Width="{Static entity:ChildInOutCareItem.GenderGridLength}" />
        </Grid.ColumnDefinitions>
        
        <CheckBox 
            x:Name="ItemCheckBox"
            Grid.Column="0"
            InputTransparent="True" />

        <!-- 
            Setting BackgroundColor explicitly on each Label because of a layout issue. The labels don't render unless
            it's set.
        -->
        <Label
            Grid.Column="1"
            BackgroundColor="White"
            Text="{Binding LastName}" />

        <Label
            Grid.Column="2"
            BackgroundColor="White"
            Text="{Binding FirstName}" />

        <Label
            Grid.Column="3"
            BackgroundColor="White"
            Text="{Binding DateOfBirth}" />

        <Label
            Grid.Column="4"
            BackgroundColor="White"
            Text="{Binding Sex}" />
    </Grid>
    
</ContentView>
