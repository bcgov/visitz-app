<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:BaseContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:attachments="clr-namespace:Visitz.Views.Entity.Attachments"
	xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
	xmlns:controls="clr-namespace:Visitz.Controls"
	xmlns:model="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
	xmlns:icons="clr-namespace:Visitz.FontIcons"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Visitz.Views.Entity.Attachments.AttachmentListItemView"
	x:DataType="model:AttachmentDraft">

	<baseClasses:BaseContentView.Resources>
		<ResourceDictionary>
			<toolkit:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
		</ResourceDictionary>
	</baseClasses:BaseContentView.Resources>

	<VerticalStackLayout Padding="20,10,20,0">
		<VerticalStackLayout.GestureRecognizers>
			<TapGestureRecognizer
				Command="{Binding OpenAttachmentCommand,
					Source={RelativeSource AncestorType={x:Type attachments:AttachmentsListViewModel}}}"
				CommandParameter="{Binding .}" />
		</VerticalStackLayout.GestureRecognizers>

		<Grid
			HorizontalOptions="Fill"
			ColumnDefinitions="Auto, *, Auto, Auto, Auto"
			ColumnSpacing="{StaticResource DefaultSpacing}">

			<Border
				Grid.Column="0"
				VerticalOptions="Center"
				StrokeShape="RoundRectangle 5"
				StrokeThickness="0">
				<Image
					Aspect="AspectFill"
					HeightRequest="100"
					WidthRequest="100"
					Source="{Binding Attachment.ThumbnailBinding,
						Converter={StaticResource ByteArrayToImageSourceConverter}}" />
			</Border>

			<Label
				Grid.Column="1"
				VerticalOptions="Center"
				Text="{Binding Attachment.FilenameBinding}" />

			<controls:RenameButton
				Grid.Column="2"
				VerticalOptions="Center"
				Renaming="{Binding Attachment.FilenameBinding}"
				TextColor="{StaticResource Gray500}" />

			<Button
				Style="{StaticResource MinimalButton}"
				Grid.Column="3"
				VerticalOptions="Center"
				Command="{Binding DeleteAttachmentDraftCommand,
					Source={RelativeSource AncestorType={x:Type attachments:AttachmentsListViewModel}}}"
				CommandParameter="{Binding .}">
				<Button.ImageSource>
					<FontImageSource 
						Glyph="{Static icons:MaterialIcons.Delete}"
						FontFamily="MaterialIconsRoundedUnfilled"
						Size="20"
						Color="{StaticResource Gray500}" />
				</Button.ImageSource>
			</Button>

			<Button
				Grid.Column="4"
				VerticalOptions="Center"
				Command="{Binding PublishAttachmentDraftCommand,
					Source={RelativeSource AncestorType={x:Type attachments:AttachmentsListViewModel}}}"
				CommandParameter="{Binding .}">
				<Button.ImageSource>
					<FontImageSource 
						Glyph="{Static icons:MaterialIcons.Publish}"
						FontFamily="MaterialIconsRoundedUnfilled"
						Size="20"
						Color="{StaticResource White}" />
				</Button.ImageSource>
			</Button>
		</Grid>

		<BoxView
			Margin="0,10,0,0"
			HeightRequest="0.5"
			Color="{StaticResource SeparatorColor}" />
	</VerticalStackLayout>
</baseClasses:BaseContentView>
