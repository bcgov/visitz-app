<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:ViewModelContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:banners="clr-namespace:Visitz.Views.Banners"
	xmlns:attachments="clr-namespace:Visitz.Views.Entity.Attachments"
	xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
	xmlns:icons="clr-namespace:Visitz.FontIcons"
	xmlns:local="clr-namespace:Visitz.Localization"
    x:Class="Visitz.Views.Entity.Attachments.AttachmentsView"
	x:DataType="attachments:AttachmentsViewModel">

    <Grid
		HorizontalOptions="FillAndExpand"
		VerticalOptions="FillAndExpand"
		RowDefinitions="Auto, *, 0.5, Auto">

        <CollectionView
            Grid.Row="0"
            ItemsSource="{Binding Tabs}"
            ItemsLayout="HorizontalList"
            SelectionChangedCommand="{Binding TabChangedCommand}"
            SelectedItem="{Binding SelectedTab}"
            SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView
                        Padding="{Thickness
                            Left={StaticResource DefaultMargin},
                            Right={StaticResource DefaultMargin}}">
                        
                        <AbsoluteLayout>
                            <Label
                                x:Name="TabName"
                                AbsoluteLayout.LayoutFlags="PositionProportional"
                                AbsoluteLayout.LayoutBounds="0.5,0.5"
                                Padding="{StaticResource DefaultPadding}"
                                Text="{Binding .}" />

                            <BoxView
                                x:Name="Indicator"
                                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
                                AbsoluteLayout.LayoutBounds="0.5,1,1,-1"
                                HeightRequest="5"
                                Color="{StaticResource Primary}" />
                        </AbsoluteLayout>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="TabName" Property="Label.FontFamily" Value="BCSansRegular" />
                                        <Setter TargetName="TabName" Property="Label.TextColor" Value="{StaticResource BC_TextColor}" />
                                        <Setter TargetName="Indicator" Property="BoxView.IsVisible" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter TargetName="TabName" Property="Label.FontFamily" Value="BCSansBold" />
                                        <Setter TargetName="TabName" Property="Label.TextColor" Value="{StaticResource Primary}" />
                                        <Setter TargetName="Indicator" Property="BoxView.IsVisible" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <ContentView
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            Grid.Row="1"
            Content="{Binding SelectedView}" />

		<BoxView
			Grid.Row="2"
			Color="{StaticResource SeparatorColor}" />

		<Grid
			Grid.Row="3"
			Padding="{StaticResource DefaultPadding}"
			RowDefinitions="Auto"
			ColumnSpacing="{StaticResource DefaultSpacing}"
			ColumnDefinitions="*,Auto,Auto">

			<Button
				Style="{StaticResource SecondaryButton}"
				Grid.Column="1"
				Text="{local:Localize Browse}"
				Clicked="Browse_Clicked"
				IsVisible="{OnPlatform iOS=False}">
				<Button.ImageSource>
					<FontImageSource
						Glyph="{Static icons:MaterialIcons.Folder_open}"
						FontFamily="MaterialIconsRoundedUnfilled"
						Size="20"
						Color="{StaticResource Primary}" />
				</Button.ImageSource>
			</Button>

			<Button
				Style="{OnPlatform WinUI={StaticResource SecondaryButton}, Default={StaticResource PrimaryButton}}"
				Grid.Column="2"
				Clicked="AddPhotos_Clicked"
				Text="{local:Localize AddPhotos}">
				<Button.ImageSource>
					<FontImageSource
						Glyph="{Static icons:MaterialIcons.Add_a_photo}"
						FontFamily="MaterialIconsRoundedUnfilled"
						Size="20"
						Color="{OnPlatform WinUI={StaticResource Primary}, Default={StaticResource White}}" />
				</Button.ImageSource>
			</Button>
		</Grid>
	</Grid>

</baseClasses:ViewModelContentView>
