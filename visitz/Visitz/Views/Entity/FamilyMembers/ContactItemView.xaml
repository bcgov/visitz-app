<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:tagBehaviors="clr-namespace:Visitz.Behaviors.Tags"
    xmlns:tagview="clr-namespace:Visitz.Views.TagViews"
    xmlns:people="clr-namespace:VisitzModel.Models.People;assembly=VisitzModel"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    x:Class="Visitz.Views.Entity.FamilyMembers.ContactItemView"
    x:DataType="people:IcmContact"
    HorizontalOptions="Start">

    <Grid
        RowDefinitions="*,*,*,*,*,*,*,*"
        RowSpacing="10"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="10"
        Margin="10,20,10,20">

        <HorizontalStackLayout
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Spacing="5"
            Padding="10,0,10,0">
            
            <Label
                Text="{Binding FullDisplayName}"
                FontFamily="BCSansBold"
                FontSize="17"/>

            <tagview:TagView Padding="8,0">
                <tagview:TagView.Behaviors>
                    <tagBehaviors:ContactRelationshipTagBehavior />
                </tagview:TagView.Behaviors>
            </tagview:TagView>
        </HorizontalStackLayout>

        <Label 
            Grid.Row="1"
            FontFamily="BCSansBold"
            HorizontalOptions="End"
            Text="{local:Localize Age}" />

        <Label 
            Grid.Row="1"
            Grid.Column="1"
            HorizontalOptions="Start"
            FontFamily="BCSansRegular"            
            Text="{Binding Age}" />

        <Label 
            Grid.Row="2"
            FontFamily="BCSansBold"
            HorizontalOptions="End"
            Text="{local:Localize Birthdate}" />

        <Label 
            Grid.Row="2"
            Grid.Column="1"
            HorizontalOptions="Start"
            FontFamily="BCSansRegular"
            Text="{Binding DateOfBirthFormatted}" />

        <Label 
            Grid.Row="3"
            FontFamily="BCSansBold"
            HorizontalOptions="End"
            Text="{local:Localize Gender}" />

        <Label 
            Grid.Row="3"
            Grid.Column="1"
            HorizontalOptions="Start"
            FontFamily="BCSansRegular"
            Text="{Binding Gender}" />

        <Label 
            Grid.Row="4"
            FontFamily="BCSansBold"
            HorizontalOptions="End"
            Text="{local:Localize Indigenous}" />

        <Label 
            Grid.Row="4"
            Grid.Column="1"
            HorizontalOptions="Start"
            FontFamily="BCSansRegular"
            Text="{Binding Indigenous}" />

        <Label 
            Grid.Row="5"
            FontFamily="BCSansBold"
            HorizontalOptions="End"
            Text="{local:Localize Address}" />

        <Label 
            Grid.Row="5"
            Grid.Column="1"
            HorizontalOptions="Start"
            FontFamily="BCSansRegular"
            Text="{Binding PrimaryAddress}" />

		<Label 
			Grid.Row="6"
			FontFamily="BCSansBold"
			HorizontalOptions="End"
			Text="{local:Localize HomeNumber}" />

		<Label 
			Grid.Row="6"
			Grid.Column="1"
			HorizontalOptions="Start"
			FontFamily="BCSansRegular"
			Text="{Binding HomePhoneFormatted}" />

		<Label 
			Grid.Row="7"
			FontFamily="BCSansBold"
			HorizontalOptions="End"
			Text="{local:Localize CellNumber}" />

		<Label 
			Grid.Row="7"
			Grid.Column="1"
			HorizontalOptions="Start"
			FontFamily="BCSansRegular"
			Text="{Binding CellPhoneFormatted}" />
	</Grid>
</ContentView>
