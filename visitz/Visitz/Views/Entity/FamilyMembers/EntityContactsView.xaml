<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:familyMembers="clr-namespace:Visitz.Views.Entity.FamilyMembers"
    xmlns:models="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Entity.FamilyMembers.EntityContactsView"
    x:DataType="familyMembers:EntityContactsViewModel">

    <CollectionView
        ItemSizingStrategy="MeasureFirstItem"
        ItemsSource="{Binding Contacts}"
        SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:FamilyMember">
                <familyMembers:ContactItemView />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</views:ViewModelContentView>
