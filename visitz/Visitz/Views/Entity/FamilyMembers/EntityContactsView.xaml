<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:familyMembers="clr-namespace:Visitz.Views.Entity.FamilyMembers"
    xmlns:people="clr-namespace:VisitzModel.Models.People;assembly=VisitzModel"
    x:Class="Visitz.Views.Entity.FamilyMembers.EntityContactsView"
    x:DataType="familyMembers:EntityContactsViewModel">

    <CollectionView
        ItemSizingStrategy="MeasureFirstItem"
        ItemsSource="{Binding Contacts}"
        SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="people:IcmContact">
                <familyMembers:ContactItemView />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</baseClasses:ViewModelContentView>
