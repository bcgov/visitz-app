<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:childYouthInfo="clr-namespace:Visitz.Views.Entity.ChildYouthInfo"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:peopleModels="clr-namespace:VisitzModel.Models.People;assembly=VisitzModel"
    x:Class="Visitz.Views.Entity.ChildYouthInfo.ContactEducationListItem"
    x:DataType="peopleModels:ContactEducation"
>
    <ContentView.Resources>
        <Style TargetType="formControls:InfoItemView">
            <Setter Property="LabelFontFamily" Value="BCSansBold" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="{StaticResource DefaultSpacing}">
        <formControls:InfoItemView
            Label="{local:Localize SchoolName}"
            Value="{Binding SchoolNameBinding}"
        />
        <formControls:InfoItemView
            Label="{local:Localize StartDate}"
            Value="{Binding DisplayStartDate}"
        />
        <formControls:InfoItemView
            Label="{local:Localize Last grade completed}"
            Value="{Binding DegreeBinding}"
        />
        <formControls:InfoItemView
            Label="{local:Localize Contact person}"
            Value="{Binding ContactPersonBinding}"
        />
        <formControls:InfoItemView
            Label="{local:Localize Contact person role}"
            Value="{Binding ContactPersonRoleBinding}"
        />
        <formControls:InfoItemView
            Label="{local:Localize Phone}"
            Value="{Binding PhoneNumBinding}"
        />
        <formControls:InfoItemView
            Label="{local:Localize Address}"
            Value="{Binding AddressBinding}"
        />
    </VerticalStackLayout>
</ContentView>
