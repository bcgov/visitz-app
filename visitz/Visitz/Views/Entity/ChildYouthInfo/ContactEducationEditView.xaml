<?xml version="1.0" encoding="utf-8" ?>
<base:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:childYouthInfo="clr-namespace:Visitz.Views.Entity.ChildYouthInfo"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    x:Class="Visitz.Views.Entity.ChildYouthInfo.ContactEducationEditView"
    x:DataType="childYouthInfo:ContactEducationEditViewModel"
    x:TypeArguments="childYouthInfo:ContactEducationEditViewModel"
>
    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="0"
        Padding="{StaticResource DefaultPadding}"
    >
        <Grid RowDefinitions="Auto, *">
            <formControls:FormAppBar
                Grid.Row="0"
                IsReadOnly="False"
                AllowDiscard="{Binding CanDiscard}"
                EnablePublish="{Binding AllowPublish}"
                DraftSaveState="{Binding DraftSaveState}"
                DiscardCommand="{Binding DiscardDraftCommand}"
                PublishCommand="{Binding PublishDraftCommand}"
            />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout>
                    <formControls:FormEntry Text="{Binding Draft.ContactEducation.CommentsBinding}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</base:IcmRecordContentView>
