<?xml version="1.0" encoding="utf-8" ?>
<base:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:childYouthInfo="clr-namespace:Visitz.Views.Entity.ChildYouthInfo"
    xmlns:formControls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    x:Class="Visitz.Views.Entity.ChildYouthInfo.ContactEducationEditView"
    x:DataType="childYouthInfo:ContactEducationEditViewModel"
    x:TypeArguments="childYouthInfo:ContactEducationEditViewModel"
>
    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="0"
        Padding="{StaticResource DefaultPadding}"
    >
        <Grid RowDefinitions="Auto, *">
            <formControls:FormAppBar
                Grid.Row="0"
                IsReadOnly="False"
                AllowDiscard="{Binding CanDiscard}"
                EnablePublish="{Binding AllowPublish}"
                DraftSaveState="{Binding DraftSaveState}"
                DiscardCommand="{Binding DiscardDraftCommand}"
                PublishCommand="{Binding PublishDraftCommand}"
            />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="{StaticResource DefaultSpacing}">
                    <formControls:FormEntry
                        FieldName="{local:Localize SchoolName}"
                        Text="{Binding Draft.ContactEducation.SchoolNameBinding}"
                    />

                    <ContentView>
                        <VerticalStackLayout>
                            <Label Text="{local:Localize StartDate}" />

                            <DatePicker Date="{Binding Draft.ContactEducation.StartDateBinding}" />
                        </VerticalStackLayout>
                    </ContentView>

                    <formControls:FormEntry
                        FieldName="{local:Localize LastGradeCompleted}"
                        Text="{Binding Draft.ContactEducation.DegreeBinding}"
                    />

                    <formControls:FormEntry
                        FieldName="{local:Localize ContactPerson}"
                        Text="{Binding Draft.ContactEducation.ContactPersonBinding}"
                    />

                    <formControls:FormEntry
                        FieldName="{local:Localize ContactPersonRole}"
                        Text="{Binding Draft.ContactEducation.ContactPersonRoleBinding}"
                    />

                    <formControls:FormEntry
                        FieldName="{local:Localize Phone}"
                        Text="{Binding Draft.ContactEducation.PhoneNumBinding}"
                    />

                    <formControls:FormEntry
                        FieldName="{local:Localize Address}"
                        Text="{Binding Draft.ContactEducation.AddressBinding}"
                    />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</base:IcmRecordContentView>
