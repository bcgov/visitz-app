<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
    xmlns:childYouthVisit="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:visitStrings="clr-namespace:VisitzModel.Resources.Localization;assembly=VisitzModel"
    x:Class="Visitz.Views.Entity.ChildYouthVisits.ChildYouthVisitView"
    x:DataType="childYouthVisit:ChildYouthVisitViewModel"
    x:TypeArguments="childYouthVisit:ChildYouthVisitViewModel"
>
    <baseClasses:IcmRecordContentView.Resources>
        <ResourceDictionary>
            <toolkit:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter" />
            <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        </ResourceDictionary>
    </baseClasses:IcmRecordContentView.Resources>

    <baseClasses:IcmRecordContentView.Behaviors>
        <behaviors:SoftKbResizeBehavior />
    </baseClasses:IcmRecordContentView.Behaviors>

    <Border Background="White" StrokeShape="RoundRectangle 10" StrokeThickness="0">
        <Grid RowDefinitions="Auto,*" Padding="{StaticResource DefaultPadding}">
            <formctls:FormAppBar
                x:Name="FormAppBar"
                Grid.Row="0"
                AllowDiscard="{Binding AllowDiscard}"
                AllowPublish="{Binding AllowPublish}"
                DiscardCommand="{Binding DiscardDraftCommand}"
                PublishCommand="{Binding PublishInPersonVisitCommand}"
                DraftSaveState="{Binding DraftSaveState}"
            />

            <ScrollView Grid.Row="1">
                <StackLayout Orientation="Vertical" Margin="5">
                    <Grid Grid.Row="1" RowSpacing="15" ColumnDefinitions="*">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding DetailsRowHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            IsVisible="{Binding ShowFullForm}"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto, Auto"
                            ColumnSpacing="10"
                        >
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{local:Localize DateOfVisit}"
                            />

                            <DatePicker
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0"
                                Format="MMMM dd, yyyy"
                                MaximumDate="{Binding MaxDate}"
                                IsEnabled="{Binding IsUpdatingEnabled}"
                                Date="{Binding PersonVisitItem.DateOfVisitBinding, Converter={StaticResource DateTimeOffsetConverter}}"
                            >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Disabled" />
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </DatePicker>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            IsVisible="{Binding ShowFullForm}"
                            RowDefinitions="Auto, *"
                            ColumnSpacing="40"
                        >
                            <Label Text="{local:Localize VisitDetails}" />

                            <CollectionView Grid.Row="1" ItemsSource="{Binding DetailItems}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="childYouthVisit:VisitDetailListItem">
                                        <formctls:FormCheckBox
                                            Background="White"
                                            HorizontalOptions="Fill"
                                            IsReadOnly="{Binding IsUpdatingEnabled,
                                        Source={RelativeSource AncestorType={x:Type childYouthVisit:ChildYouthVisitViewModel}},
                                        Converter={StaticResource BoolNegationConverter}}"
                                            IsChecked="{Binding IsChecked}"
                                            Text="{Binding DetailValue}"
                                        />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <formctls:FormEntry
                            x:Name="VisitsEditor"
                            Grid.Row="2"
                            FieldNameIsVisible="True"
                            FieldName="{local:Localize VisitDescription}"
                            Placeholder="{local:Localize Description}"
                            Text="{Binding PersonVisitItem.VisitDescriptionBinding}"
                            MaxLength="{Static childYouthVisit:ChildYouthVisitViewModel.CharacterLimit}"
                        />
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Grid>
    </Border>
</baseClasses:IcmRecordContentView>
