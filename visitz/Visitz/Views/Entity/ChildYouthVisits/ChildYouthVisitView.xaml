<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:visitStrings="clr-namespace:VisitzModel.Resources.Localization;assembly=VisitzModel"
    xmlns:formctls="clr-namespace:Visitz.Views.FormControls"
    xmlns:childYouthVisit="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Entity.ChildYouthVisits.ChildYouthVisitView"
    x:DataType="childYouthVisit:ChildYouthVisitViewModel">

    <baseClasses:ViewModelContentView.Resources>
        <ResourceDictionary>
            <toolkit:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter"/>
            <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        </ResourceDictionary>
        
    </baseClasses:ViewModelContentView.Resources>
    
    <baseClasses:ViewModelContentView.Behaviors>
        <behaviors:SoftKbResizeBehavior/>
    </baseClasses:ViewModelContentView.Behaviors>

    <Border
        Background="White"
        Padding="-5"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="0">

        <Grid
            Margin="5"
            Padding="20"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            RowDefinitions="Auto, *">

            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto">

                <controls:CloseButton
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalOptions="Center"
                    TextColor="{StaticResource Gray600}"/>

                <views:DraftSavedView
                    x:Name="DraftSavedIndicator"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalOptions="Center"/>

                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    Spacing="10">

                    <views:InternetInfoView /> 

                    <Button
                        Style="{StaticResource SecondaryButtonLight}"
                        Text="{local:Localize DiscardDraft}"
                        Clicked="Discard_Clicked"
                        IsEnabled="{Binding AllowDiscard}"
                        IsVisible="{Binding HideElements}" />

                    <Button
                        Text="{local:Localize PublishToIcm}"
                        Command="{Binding PublishInPersonVisitCommand}"
                        IsEnabled="{Binding AllowPublish}"
                        IsVisible="{Binding HideElements}" />

                    <Label
                        Text="Read-only"
                        FontFamily="BCSansItalic"
                        VerticalOptions="Center"
                        IsVisible="{Binding IsUpdatingEnabled, Converter={StaticResource BoolNegationConverter}}" />
                </HorizontalStackLayout>
            </Grid>

            <Grid
                Grid.Row="1"
                RowSpacing="15"
                RowDefinitions="Auto, Auto, *">

                <!-- First Row: Date Picker -->
                <Grid
                    Grid.Row="0"
                    IsVisible="{Binding ShowFullForm}"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto, Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="{local:Localize DateOfVisit}"/>

                    <DatePicker
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0"
                        Format="MMMM dd, yyyy"
                        MaximumDate="{Binding MaxDate}"
                        IsEnabled="{Binding IsUpdatingEnabled}"
                        Date="{Binding PersonVisitItem.DateOfVisitBinding, Converter={StaticResource DateTimeOffsetConverter}}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </DatePicker>
                </Grid>

                <!-- Second Row: RadioButton and Checkbox -->
                <Grid
                    Grid.Row="1"
                    IsVisible="{Binding ShowFullForm}"
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto, Auto"
                    ColumnSpacing="40">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="{local:Localize VisitType}"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"/>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Spacing="10"
                        HeightRequest="180"
                        IsEnabled="{Binding IsUpdatingEnabled}"
                        RadioButtonGroup.GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitTypeGroup}"
                        RadioButtonGroup.SelectedValue="{Binding PersonVisitItem.VisitDetailsGroupBinding}">
                        <formctls:FormRadioButton
                            Value="{Static visitStrings:PersonVisitDetails.Type_PrivateVisit}"
                            IsChecked="{Binding PrivateChecked}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitTypeGroup}"
                            Text="{Static visitStrings:PersonVisitDetails.Type_PrivateVisit}"/>
                        <formctls:FormRadioButton
                            Value="{Static visitStrings:PersonVisitDetails.Type_ExemptionToPrivateVisit}"
                            IsChecked="{Binding ExemptionToPrivateVisitChecked}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitTypeGroup}"
                            Text="{Static visitStrings:PersonVisitDetails.Type_ExemptionToPrivateVisit}"/>
                        <formctls:FormRadioButton
                            Value="{Static visitStrings:PersonVisitDetails.Type_NotPrivate}"
                            IsChecked="{Binding NotPrivateChecked}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitTypeGroup}"
                            Text="{Static visitStrings:PersonVisitDetails.Type_NotPrivate}"/>
                    </VerticalStackLayout>

                    <!-- Checkbox shown only if the RadioButton is selected -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{local:Localize VisitDetails}"
                        IsVisible="{Binding IsVisitTypeSelected}"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"/>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="{Binding IsUpdatingEnabled}"
                        IsVisible="{Binding PrivateChecked}"
                        RadioButtonGroup.GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                        RadioButtonGroup.SelectedValue="{Binding PersonVisitItem.VisitDetailsValueBinding}">
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_Age0To5}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_Age0To5}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitAge0To5Checked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_InHome}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_InHome}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitInHomeChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_MedicalOrSupportNeeds}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_MedicalOrSupportNeeds}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitMedicalOrSupportNeedsChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_NotInHome}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_NotInHome}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitNotInHomeChecked}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="{Binding IsUpdatingEnabled}"
                        IsVisible="{Binding ExemptionToPrivateVisitChecked}"
                        RadioButtonGroup.GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                        RadioButtonGroup.SelectedValue="{Binding PersonVisitItem.VisitDetailsValueBinding}">
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_ChildDeclinedToMeet}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_ChildDeclinedToMeet}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding ChildDeclinedToMeetChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_Other}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_Other}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding OtherChecked}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="{Binding IsUpdatingEnabled}"
                        IsVisible="{Binding NotPrivateChecked}"
                        RadioButtonGroup.GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                        RadioButtonGroup.SelectedValue="{Binding PersonVisitItem.VisitDetailsValueBinding}">
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_PlanningMeeting}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_PlanningMeeting}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding PlanningMeetingChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_RelationalVisit}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_RelationalVisit}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding RelationalVisitChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_VisitInTheHome}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_VisitInTheHome}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitInTheHomeChecked}"/>
                        <formctls:FormRadioButton
                            Text="{Static visitStrings:PersonVisitDetails.Details_VisitWithCaregiver}"
                            Value="{Static visitStrings:PersonVisitDetails.Details_VisitWithCaregiver}"
                            GroupName="{Static childYouthVisit:ChildYouthVisitViewModel.VisitDetailGroup}"
                            IsChecked="{Binding VisitWithCaregiverChecked}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Third Row: Description TextField -->
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    RowDefinitions="Auto, *"
                    ColumnSpacing="10">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="{local:Localize VisitDescription}"/>
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        IsVisible="{Binding HideElements}"
                        Text="{Binding RemainingCharacters, StringFormat={Static childYouthVisit:ChildYouthVisitViewModel.RemainingCharactersString}}"
                        Style="{StaticResource LabelSmall}"/>
                    <AbsoluteLayout
                        Grid.Row="1"
                        VerticalOptions="FillAndExpand">

                        <controls:EditorEx
                            x:Name="VisitsEditor"
                            AbsoluteLayout.LayoutFlags="All"
                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                            CharacterCount="{Binding CharacterCount}"
                            EmojiEntered="VisitsEditor_EmojiEntered"
                            SuggestedMaxLength="{Static childYouthVisit:ChildYouthVisitViewModel.CharacterLimit}"
                            SuggestedMaxLengthExceeded="VisitsEditor_SuggestedMaxLengthExceeded"
                            Text="{Binding PersonVisitItem.VisitDescriptionBinding}"
                            TextColor="{StaticResource BlackishText}"
                            FontFamily="BCSansRegular"
                            IsReadOnly="{Binding IsUpdatingEnabled, Converter={StaticResource BoolNegationConverter}}"
                            FontSize="17">
                            
                        </controls:EditorEx>

                        <views:ErrorTooltip
                            x:Name="EditorError"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            AbsoluteLayout.LayoutBounds="0.5,-.08"
                            IsVisible="False"/>
                    </AbsoluteLayout>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</baseClasses:ViewModelContentView>
