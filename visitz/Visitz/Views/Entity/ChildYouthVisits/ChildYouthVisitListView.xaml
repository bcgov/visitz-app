<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:childYouthVisit="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    x:Class="Visitz.Views.Entity.ChildYouthVisits.ChildYouthVisitListView"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:banners="clr-namespace:Visitz.Views.Banners"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:models="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
    xmlns:visits="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    x:DataType="childYouthVisit:ChildYouthVisitListViewModel">
    <Grid
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand"
        RowDefinitions="Auto, Auto, *, Auto">

        <banners:InfoBanner
            Grid.Row="0"
            Margin="20"
            IsVisible="{Binding HasVisitData}"
            Level="{Binding BannerLevel}"
            Text="{Binding BannerText}"/>

        <Grid
            Grid.Row="1"
            IsVisible="{Binding HasVisitData}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Text="Date"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontFamily="BCSansBold"/>
            <Label Text="Details"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Grid.Column="1"
                   FontFamily="BCSansBold"/>
            <Label Text="Description"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Grid.Column="2"
                   FontFamily="BCSansBold"/>
            <Label Text="Created By"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Grid.Column="3"
                   FontFamily="BCSansBold"/>
        </Grid>

        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding HasVisitData}"
            ItemsSource="{Binding InPersonVisitList}"
            Margin="10"
            VerticalOptions="FillAndExpand"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <Grid
                            ColumnSpacing="{StaticResource DefaultSpacing}"
                            Padding="{StaticResource DefaultPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding DateOfVisit, StringFormat='{0:MMMM dd, yyyy}'}"
                                    Grid.Column="0"/>
                            <Label Text="{Binding Type}"
                                    Grid.Column="1"/>
                            <Label Text="{Binding VisitDescription}"
                                    Grid.Column="2"/>
                            <Label Text="{Binding CreatedBy}"
                                    Grid.Column="3"/>
                        </Grid>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontSize="200"
            TextColor="#919197"
            Text="{Static icons:MaterialIcons.Note_stack}"
            FontFamily="MaterialIconsRoundedUnfilled"
            IsVisible="{Binding ShowEmptyIcon}"/>

    </Grid>
</base:ViewModelContentView>
