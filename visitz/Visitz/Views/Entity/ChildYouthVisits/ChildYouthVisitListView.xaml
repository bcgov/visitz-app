<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:childYouthVisit="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    x:Class="Visitz.Views.Entity.ChildYouthVisits.ChildYouthVisitListView"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:banners="clr-namespace:Visitz.Views.Banners"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:models="clr-namespace:VisitzModel.Models;assembly=VisitzModel"
    xmlns:visits="clr-namespace:Visitz.Views.Entity.ChildYouthVisits"
    x:DataType="childYouthVisit:ChildYouthVisitListViewModel">
    <Grid
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand"
        RowDefinitions="Auto, Auto, 0.5, *">

        <banners:InfoBanner
            Grid.Row="0"
            Margin="{StaticResource DoubleDefaultMargin}"
            IsVisible="{Binding HasVisitData}"
            Level="{Binding BannerLevel}"
            Text="{Binding BannerText}"/>

        <Grid
            Grid.Row="1"
            Margin="{StaticResource DoubleDefaultMargin}"
            IsVisible="{Binding HasVisitData}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Text="{local:Localize Date}"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Center"
                   TextColor="{StaticResource BC_TextColor_Lighter}"
                   FontFamily="BCSansBold"/>
            <Label Text="{local:Localize Details}"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Center"
                   Grid.Column="1"
                   TextColor="{StaticResource BC_TextColor_Lighter}"
                   FontFamily="BCSansBold"/>
            <Label Text="{local:Localize Description}"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Center"
                   Grid.Column="2"
                   TextColor="{StaticResource BC_TextColor_Lighter}"
                   FontFamily="BCSansBold"/>
            <Label Text="{local:Localize CreatedBy}"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Center"
                   Grid.Column="3"
                   TextColor="{StaticResource BC_TextColor_Lighter}"
                   FontFamily="BCSansBold"/>
        </Grid>
        <BoxView
            Grid.Row="2"
            HeightRequest="0.5"
            Color="{StaticResource SeparatorColor}"/>

        <CollectionView
            Grid.Row="3"
            IsVisible="{Binding HasVisitData}"
            ItemsSource="{Binding InPersonVisitList}"
            Margin="{StaticResource DefaultMargin}"
            VerticalOptions="FillAndExpand"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <VerticalStackLayout>
                            <Grid
                                ColumnSpacing="{StaticResource DefaultSpacing}"
                                Padding="{StaticResource DefaultPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label
                                    Text="{Binding DateOfVisit, StringFormat='{0:MMMM dd, yyyy}'}"
                                    Grid.Column="0"/>
                                <Label
                                    Text="{Binding Type}"
                                    Grid.Column="1"/>
                                <Label
                                    Text="{Binding VisitDescription}"
                                    Grid.Column="2"/>
                                <Label
                                    Text="{Binding CreatedBy}"
                                    Grid.Column="3"/>
                            </Grid>
                            <BoxView
                                Color="{StaticResource Gray200}"
                                HeightRequest="0.5"/>
                        </VerticalStackLayout>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="3"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontSize="200"
            TextColor="#919197"
            Text="{Static icons:MaterialIcons.Note_stack}"
            FontFamily="MaterialIconsRoundedUnfilled"
            IsVisible="{Binding ShowEmptyIcon}"/>

    </Grid>
</base:ViewModelContentView>
