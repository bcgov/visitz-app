<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:tagview="clr-namespace:Visitz.Views.TagViews"
    xmlns:entity="clr-namespace:Visitz.ViewModels.Entity"
    xmlns:tagBehaviors="clr-namespace:Visitz.Behaviors.Tags"
    x:Class="Visitz.Views.Entity.EntityContainerView"
    x:DataType="entity:EntityContainerViewModel">
    
    <StackLayout
        Orientation="Vertical"
        IsClippedToBounds="True">

        <Grid 
            Padding="10"
            BackgroundColor="White"
            HeightRequest="{StaticResource TopAppBarHeight}"
            ColumnDefinitions="*,Auto"
            Shadow="{StaticResource RestingLevel2}"
            ZIndex="2">
            
            <Label 
                Grid.Column="0"
                Text="{Binding CaseloadItem.DisplayName}"
                FontSize="{StaticResource TitleLargeFontSize}"
                LineBreakMode="TailTruncation"
                HorizontalOptions="StartAndExpand"
                VerticalOptions="Center" />

			<HorizontalStackLayout
				Grid.Column="1"
				VerticalOptions="Center"
				Spacing="5">
				<tagview:EntityTypeBadge BindingContext="{Binding CaseloadItem}" />
				
				<Label
					FontSize="{StaticResource TitleMediumFontSize}"
					Text="{Binding CaseloadItem.FullType}"
					TextColor="{Binding EntityTypeTextColor}" />
			</HorizontalStackLayout>
        </Grid>

        <ContentView 
            x:Name="ContainerDetails"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand" />
    </StackLayout>
    
</views:ViewModelContentView>
