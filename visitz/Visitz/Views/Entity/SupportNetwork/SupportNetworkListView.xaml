<?xml version="1.0" encoding="utf-8" ?>
<base:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:supportNetwork="clr-namespace:Visitz.Views.Entity.SupportNetwork"
    x:Class="Visitz.Views.Entity.SupportNetwork.SupportNetworkListView"
    x:DataType="supportNetwork:SupportNetworkListViewModel"
    x:TypeArguments="supportNetwork:SupportNetworkListViewModel"
>
    <Grid VerticalOptions="Fill" RowDefinitions="*">
        <CollectionView
            Grid.Row="0"
            x:Name="SupportNetworksCollectionView"
            ItemsSource="{Binding SupportNetworksList}"
            SelectionMode="None"
        >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="supportNetwork:SupportNetworkItemUi">
                    <supportNetwork:SupportNetworkListItem />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:EmptyIcon Grid.Row="0" IsVisible="{Binding ShowEmptyIcon}" />
    </Grid>
</base:IcmRecordContentView>
