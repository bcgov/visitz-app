<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:icons="clr-namespace:Visitz.FontIcons"
	xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.EmptyCollectionMessage"
	x:DataType="views:EmptyCollectionMessage"
	x:Name="this">
	
	<VerticalStackLayout
		BindingContext="{Reference this}"
		Spacing="{OnPlatform WinUI=0, Default=40}">
		<Label
			HorizontalOptions="Center"
			FontAutoScalingEnabled="False"
			FontFamily="FluentIconsRegular"
			FontSize="160"
			TextColor="{StaticResource Primary}"
			Text="{Static icons:FluentIcons.Clipboard_task_list_ltr_20_filled}" />

		<Label
			HorizontalOptions="Center"
			HorizontalTextAlignment="Center"
			FontSize="20"
			Text="{Binding Text}" />
	</VerticalStackLayout>
</ContentView>
