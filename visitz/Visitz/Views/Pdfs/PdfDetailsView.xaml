<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:drafts="clr-namespace:Visitz.Views.Drafts"
    xmlns:pdfs="clr-namespace:Visitz.Views.Pdfs"
    x:Class="Visitz.Views.Pdfs.PdfDetailsView"
    x:DataType="pdfs:PdfDetailsViewModel"
    Background="White">

    <Grid
        RowDefinitions="Auto,*">
        
        <drafts:EditDraftAppBar
            Grid.Row="0"
            Background="White"
            AllowDiscard="False"
            AllowPublish="False"
            IsReadOnly="True"
            Shadow="{StaticResource RestingLevel3}"/>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding ShowActivityIndicator}" />

        <Label
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorText}" />

        <WebView
            Grid.Row="1"
            Background="Coral"
            Source="{Binding Source}"
            Navigated="WebView_Navigated">
        </WebView>
    </Grid>

</base:ViewModelContentView>
