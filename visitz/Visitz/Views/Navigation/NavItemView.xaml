<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:navModels="clr-namespace:VisitzModel.Models.Navigation;assembly=VisitzModel"
	xmlns:nav="clr-namespace:Visitz.Views.Navigation"
	x:Class="Visitz.Views.Navigation.NavItemView"
	x:DataType="navModels:NavItem"
	Padding="8">

	<VisualStateManager.VisualStateGroups>
		<VisualStateGroup x:Name="CommonStates">
			<VisualState x:Name="Normal">
				<VisualState.Setters>
					<Setter TargetName="IconImage" Property="Image.Source" Value="{Binding UnselectedImageSource}" />
					<Setter Property="BackgroundColor" Value="Transparent" />
				</VisualState.Setters>
			</VisualState>
			<VisualState x:Name="Selected">
				<VisualState.Setters>
					<Setter TargetName="IconImage" Property="Image.Source" Value="{Binding SelectedImageSource}" />
					<Setter Property="BackgroundColor" Value="#33ffffff" />
				</VisualState.Setters>
			</VisualState>
		</VisualStateGroup>
	</VisualStateManager.VisualStateGroups>

	<StackLayout
		x:Name="MainStack"
		HorizontalOptions="Fill" 
		VerticalOptions="Center"
		Orientation="{Binding Orientation, Source={RelativeSource AncestorType={x:Type nav:NavItemView}}}"
		Spacing="8">
		
		<Grid
			HorizontalOptions="Center"
			VerticalOptions="FillAndExpand">
			
			<Image 
				x:Name="IconImage"
				Source="{Binding UnselectedImageSource}" 
				HeightRequest="{Binding IconSize}" 
				WidthRequest="{Binding IconSize}"
				HorizontalOptions="Center"
				VerticalOptions="Center" />

			<Border
				Margin="{OnPlatform iOS='-8,-4', Default='-16,-4'}"
				VerticalOptions="StartAndExpand"
				HorizontalOptions="EndAndExpand"
				BackgroundColor="{StaticResource BC_Gold}"
				StrokeShape="RoundRectangle 20"
				StrokeThickness="0"
				IsVisible="{Binding ShowBadge}">

				<Label
					Padding="{OnPlatform WinUI=2}"
					MinimumHeightRequest="20"
					MinimumWidthRequest="20"
					VerticalOptions="Center"
					HorizontalOptions="Center"
					FontSize="11"
					Text="{Binding BadgeCount}"
					HorizontalTextAlignment="Center"
					VerticalTextAlignment="Center"/>

			</Border>
		</Grid>
		
		<Label 
			Text="{Binding Text}"
			TextColor="{Binding Color}"
			HorizontalOptions="Center"
			VerticalOptions="Center" />
	</StackLayout>

</ContentView>
