<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:navModels="clr-namespace:VisitzModel.Models.Navigation;assembly=VisitzModel"
    xmlns:nav="clr-namespace:Visitz.Views.Navigation"
    x:Class="Visitz.Views.Navigation.NavItemView"
    x:DataType="navModels:NavItem"
    MinimumHeightRequest="64"
    MinimumWidthRequest="64"
    Padding="0">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal">
                <VisualState.Setters>
                    <Setter TargetName="IconImage"
                            Property="Image.Source"
                            Value="{Binding UnselectedImageSource}"/>
                    <Setter TargetName="SpacerBorder"
                            Property="Border.BackgroundColor"
                            Value="Transparent"/>
                    <Setter Property="BackgroundColor"
                            Value="Transparent"/>
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Selected">
                <VisualState.Setters>
                    <Setter TargetName="IconImage"
                            Property="Image.Source"
                            Value="{Binding SelectedImageSource}"/>
                    <Setter TargetName="SpacerBorder"
                            Property="Border.BackgroundColor"
                            Value="#33ffffff"/>
                    <Setter Property="BackgroundColor"
                            Value="#33ffffff"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid
        x:Name="MainStack"
        RowDefinitions="1.5*,*"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Grid Grid.Row="0">
            <Image
                x:Name="IconImage"
                Source="{Binding UnselectedImageSource}"
                HeightRequest="{Binding IconSize}"
                WidthRequest="{Binding IconSize}"
                HorizontalOptions="Center"
                VerticalOptions="End"/>
            
            <Border
                VerticalOptions="Center"
                HorizontalOptions="Center"
                TranslationX="17"
                TranslationY="0"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                IsVisible="{Binding ShowBadge}"
                BackgroundColor="{StaticResource BuildBarBackgroundColor}">

                <Border
                    x:Name="SpacerBorder"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">

                    <Border
                        Margin="2"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        BackgroundColor="{StaticResource BC_Gold}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        IsVisible="{Binding ShowBadge}">

                        <Label
                            Margin="1"
                            MinimumHeightRequest="16"
                            MinimumWidthRequest="{OnPlatform iOS=20, Default=16}"
                            FontSize="{OnPlatform iOS={StaticResource LabelSmallFontSize}, Default={StaticResource LabelMediumFontSize}}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Text="{Binding BadgeCount}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>
                </Border>
            </Border>
        </Grid>

        <Label
            Grid.Row="1"
            FontSize="14"
            Text="{Binding Text}"
            TextColor="{Binding Color}"
            HorizontalOptions="Center"
            VerticalOptions="Start"/>
    </Grid>

</ContentView>
