<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:selView="clr-namespace:Visitz.Views.SelectionView"
    xmlns:nav="clr-namespace:Visitz.Views.Navigation"
    x:Class="Visitz.Views.Navigation.TabView"
    x:DataType="nav:TabViewModel">
    
    <selView:SelectionList
        ItemsSource="{Binding Tabs}"
        Orientation="Horizontal"
        SelectedItem="{Binding SelectedTab}">

        <selView:SelectionList.ItemTemplate>
            <DataTemplate x:DataType="nav:Tab">
                <nav:TabItemView BindingContext="{Binding .}" />
            </DataTemplate>
        </selView:SelectionList.ItemTemplate>

    </selView:SelectionList>
</base:ViewModelContentView>
