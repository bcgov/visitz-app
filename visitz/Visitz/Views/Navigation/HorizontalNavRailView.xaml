<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:ViewModelContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
	xmlns:caseload="clr-namespace:Visitz.Views.Caseload"
	xmlns:controls="clr-namespace:Visitz.Controls"
	xmlns:icons="clr-namespace:Visitz.FontIcons"
	xmlns:views="clr-namespace:Visitz.Views"
	xmlns:nav="clr-namespace:Visitz.Views.Navigation"
	xmlns:selView="clr-namespace:Visitz.Views.SelectionView"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:Class="Visitz.Views.Navigation.HorizontalNavRailView"
	x:DataType="nav:NavRailViewModel"
	BackgroundColor="{StaticResource BuildBarBackgroundColor}"
	MaximumHeightRequest="72">

	<Grid ColumnDefinitions="Auto,*,Auto,Auto">
		<selView:SelectionList
			Grid.Column="0"
			Orientation="Horizontal"
			ItemsSource="{Binding NavigationItems}"
			SelectedItem="{Binding SelectedNavItem}">

			<selView:SelectionList.ItemTemplate>
				<DataTemplate>
					<nav:NavItemView Orientation="Horizontal" MinimumWidthRequest="72" />
				</DataTemplate>
			</selView:SelectionList.ItemTemplate>
		</selView:SelectionList>

		<caseload:DataRefreshButton
			Grid.Column="2"
			Orientation="Horizontal"
			HorizontalOptions="Center" />

		<Image 
			Grid.Column="3"
			VerticalOptions="Center"
			Source="bc_logo_vertical_reverse.png"/>
	</Grid>
	
</baseClasses:ViewModelContentView>
