<?xml version="1.0" encoding="utf-8" ?>
<base:ViewModelContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:todo="clr-namespace:Visitz.Views.Todo"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.Todo.TodoContainerView"
    x:DataType="todo:TodoContainerViewModel"
    x:TypeArguments="todo:TodoContainerViewModel"
    BackgroundColor="{StaticResource Default_Background}"
>
    <Grid RowDefinitions="Auto, *">
        <controls:TopAppBar Grid.Row="0" ColumnDefinitions="*,*">
            <Label
                Text="{local:Localize Todo}"
                Style="{StaticResource HeadlineMedium}"
                VerticalOptions="Center"
            />

            <controls:VisitzAvatarView Grid.Column="1" HorizontalOptions="End" />
        </controls:TopAppBar>

        <todo:TodoListView Grid.Row="1" />
    </Grid>
</base:ViewModelContentView>
