<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Visitz.Views"
    x:DataType="views:TagView"
    x:Class="Visitz.Views.TagView"
    x:Name="this">

    <Border
        x:Name="Border"
        BackgroundColor="{Binding BackgroundColor}"
        BindingContext="{x:Reference this}"
        Stroke="{Binding BorderColor}"
        StrokeThickness="{Binding StrokeThickness}"
        Margin="0">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius}" />
        </Border.StrokeShape>

        <HorizontalStackLayout
            HorizontalOptions="Center"
            Spacing="5"
            Padding="{Binding Padding}">

            <Image
                x:Name="Icon"
                HeightRequest="{Binding IconHeightRequest}"
                WidthRequest="{Binding IconWidthRequest}"
                MinimumHeightRequest="{OnPlatform WinUI=16, Default=24}"
                MinimumWidthRequest="{OnPlatform WinUI=16, Default=24}"
                Source="{Binding ImageSource}"
                Aspect="AspectFit"
                VerticalOptions="Center"
                IsVisible="False">
            </Image>

            <Label 
                x:Name="TagLabel"
                Text="{Binding Text}"
                FontSize="{Binding FontSize}"
                FontFamily="{Binding FontFamily}"
                TextColor="{Binding TextColor}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center"
                TextTransform="{Binding TextTransform}" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
