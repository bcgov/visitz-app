<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:views="clr-namespace:Visitz.Views"
    x:Class="Visitz.Views.ErrorTooltip"
    x:DataType="views:ErrorTooltip"
    x:Name="this"
>
    <VerticalStackLayout BindingContext="{Reference this}">
        <Border
            Background="{StaticResource BC_Semantic_Error}"
            StrokeShape="RoundRectangle 3"
            StrokeThickness="0"
            Padding="10,5,10,5"
        >
            <HorizontalStackLayout Spacing="5">
                <Label
                    VerticalOptions="Center"
                    FontFamily="MaterialIconsRoundedUnfilled"
                    FontSize="18"
                    Text="{Static fonticons:MaterialIcons.Error}"
                    TextColor="White"
                />

                <Label
                    x:Name="ErrorLabel"
                    VerticalOptions="Center"
                    TextColor="White"
                    Text="{Binding Text}"
                />
            </HorizontalStackLayout>
        </Border>

        <Image
            HeightRequest="10"
            WidthRequest="10"
            HorizontalOptions="Center"
            Margin="-2,0,0,0"
            Rotation="180"
        >
            <Image.Source>
                <FontImageSource
                    Glyph="{Static fonticons:MaterialIcons.Change_history}"
                    FontFamily="MaterialIconsRoundedFilled"
                    Color="{StaticResource BC_Semantic_Error}"
                />
            </Image.Source>
        </Image>
    </VerticalStackLayout>
</ContentView>
