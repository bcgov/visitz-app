<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:notes="clr-namespace:Visitz.Views.Notes"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:viewmodels="clr-namespace:Visitz.ViewModels"
    x:Class="Visitz.Views.Notes.NoteEntryView"
    x:DataType="viewmodels:NoteEntryViewModel">

    <views:ViewModelContentView.Behaviors>
        <behaviors:SoftPageKeyboardBehavior />
    </views:ViewModelContentView.Behaviors>

    <StackLayout 
        Orientation="Vertical"
        Spacing="10"
        Padding="20">

        <Grid 
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="Add Content"
                TextColor="{StaticResource BlackishText}"
                FontFamily="BCSansBold"
                FontSize="17"
                VerticalOptions="Start"/>

            <views:TagView 
                x:Name="DraftSavedTagView"
                Text="{local:Localize DraftSaved}"
                IconHeightRequest="25"
                IconWidthRequest="25"
                Grid.Row="0"
                Grid.Column="1"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="0,-3,0,0"
                TextColor="{StaticResource BC_Semantic_Success}"
                IsVisible="False">
                <views:TagView.ImageSource>
                    <FontImageSource 
                        Glyph="{Static fonticons:FluentIcons.Document_checkmark_20_regular}" 
                        FontFamily="FluentIconsRegular"
                        Color="{StaticResource BC_Semantic_Success}" />
                </views:TagView.ImageSource>
            </views:TagView>

            <views:TagView 
                x:Name="SavingDraftTagView"
                Text="{local:Localize Ellipsis}"
                IconHeightRequest="25"
                IconWidthRequest="25"
                Grid.Row="0"
                Grid.Column="1"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="0,-3,0,0"
                IsVisible="False">
                <views:TagView.ImageSource>
                    <FontImageSource 
                    Glyph="{Static fonticons:FluentIcons.Document_edit_20_regular}" 
                    FontFamily="FluentIconsRegular"
                    Color="Black" />
                </views:TagView.ImageSource>
            </views:TagView>

            <HorizontalStackLayout 
                Grid.Row="0"
                Grid.Column="2"
                Spacing="10">

                <views:InternetInfoView />

                <Button
                    Text="Publish"
                    Command="{Binding PublishNotesCommand}">

                    <Button.Style>
                        <!-- 
                            BUG: Using Background instead of BackgroundColor because of an issue:
                            https://github.com/dotnet/maui/issues/16562#issuecomment-1674953673
                        -->
                        <Style TargetType="Button">
                            <Setter Property="VisualStateManager.VisualStateGroups">
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BC_TextColor_Disabled}, Dark={StaticResource BC_TextColor_Disabled}}" />
                                                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource BC_Blue_Disabled}, Dark={StaticResource BC_Blue_Disabled}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Setter>
                        </Style>
                    </Button.Style>

                    <Button.Behaviors>
                        <behaviors:DisableWhenInternetUnavailableBehavior />
                    </Button.Behaviors>

                </Button>
            </HorizontalStackLayout>

            <Label 
                x:Name="ErrorLabel"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                TextColor="{StaticResource BC_Semantic_Error}"
                FontSize="16"
                FontFamily="BCSansBold"
                VerticalOptions="Center"
                MaxLines="1"
                LineBreakMode="TailTruncation"
                IsVisible="False"/>

            <Label
                Grid.Row="1"
                Grid.Column="2"
                TextColor="{StaticResource LightGrayText}"
                Text="{Binding CharacterLimitText}"
                FontFamily="BCSansRegular"
                FontSize="12"
                VerticalOptions="Center"
                HorizontalOptions="End" />

        </Grid>

        <AbsoluteLayout VerticalOptions="FillAndExpand">
            <Editor
                x:Name="NotesEditor"
                AbsoluteLayout.LayoutFlags="All"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                Text="{Binding Draft}"
                TextColor="{StaticResource BlackishText}"
                FontFamily="BCSansRegular"
                FontSize="17"
                Placeholder="Type your notes here..."
                TextChanged="NotesEditor_TextChanged"
                Keyboard="Text">

                <Editor.Behaviors>
                    <toolkit:UserStoppedTypingBehavior 
                        Command="{Binding SaveDraftCommand}"
                        StoppedTypingTimeThreshold="700" />
                </Editor.Behaviors>
            </Editor>

            <ImageButton
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="1,1"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Margin="10"
                Padding="5"
                BackgroundColor="{StaticResource DarkSkyBlueBackground}"
                Clicked="Scroll_To_Bottom_Clicked">

                <ImageButton.Shadow>
                    <Shadow Brush="Black"
                        Offset="10,10"
                        Radius="20"
                        Opacity="0.5" />
                </ImageButton.Shadow>

                <ImageButton.Source>
                    <FontImageSource 
                        Glyph="{Static fonticons:FluentIcons.Chevron_down_20_filled}"
                        FontFamily="FluentIconsRegular"
                        Color="White"
                        Size="44"/>
                </ImageButton.Source>

            </ImageButton>
        </AbsoluteLayout>

    </StackLayout>

</views:ViewModelContentView>
