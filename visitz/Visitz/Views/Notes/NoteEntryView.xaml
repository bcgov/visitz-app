<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:Visitz.Behaviors"
	xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:fonticons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:notes="clr-namespace:Visitz.Views.Notes"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:Visitz.Views"
    xmlns:viewmodels="clr-namespace:Visitz.ViewModels"
    x:Class="Visitz.Views.Notes.NoteEntryView"
    x:DataType="viewmodels:NoteEntryViewModel">

    <Border
        Background="White"
        Padding="-5"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="0">
        
        <StackLayout 
            Orientation="Vertical"
            Spacing="10"
            Padding="20">

            <Grid 
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto">

				<controls:CloseButton
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalOptions="Center"
					FontIconColor="{StaticResource Gray600}" />

                <views:DraftSavedView
                    x:Name="DraftSavedIndicator"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalOptions="Center" />
                
                <HorizontalStackLayout 
                    Grid.Row="0"
                    Grid.Column="2"
                    Spacing="10">

                    <views:InternetInfoView />

                    <Button
                        Text="{local:Localize PublishToIcm}"
                        Command="{Binding PublishNotesCommand}"
                        IsEnabled="{Binding AllowPublish}" />
                </HorizontalStackLayout>

            </Grid>

            <AbsoluteLayout VerticalOptions="FillAndExpand">
                <Editor
                    x:Name="NotesEditor"
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0,0,1,1"
                    Background="Transparent"
                    Text="{Binding NoteDraft.DraftBinding}"
                    TextColor="{StaticResource BlackishText}"
                    FontFamily="BCSansRegular"
                    FontSize="17"
                    Placeholder="Type your notes here..."
                    TextChanged="NotesEditor_TextChanged"
                    Keyboard="Text">

                    <Editor.Behaviors>
                        <toolkit:UserStoppedTypingBehavior 
                            Command="{Binding UserStoppedTypingCommand}"
                            StoppedTypingTimeThreshold="700" />
                    </Editor.Behaviors>
                </Editor>

                <views:ErrorTooltip 
                    x:Name="EditorError"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    AbsoluteLayout.LayoutBounds="0.5,-.08"
                    IsVisible="False" />

            </AbsoluteLayout>

        </StackLayout>
    </Border>

</views:ViewModelContentView>
