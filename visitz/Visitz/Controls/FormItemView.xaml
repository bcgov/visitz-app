<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Visitz.Controls"
             x:Class="Visitz.Controls.FormItemView"
             x:DataType="controls:FormItemView"
             x:Name="this">

    <VerticalStackLayout BindingContext="{x:Reference this}">
        
        <Label 
            Text="{Binding Name}" 
            FontSize="15"
            FontFamily="BCSansRegular"
            TextColor="#606062"
            Padding="0,10,0,0" />

        <Label 
            Text="{Binding Value}" 
            FontSize="17"
            FontFamily="BCSansRegular"
            TextColor="#131315"
            Margin="0,5,0,0" />
        
    </VerticalStackLayout>
    
</ContentView>
