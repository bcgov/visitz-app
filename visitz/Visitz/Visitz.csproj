	  <None Remove="Resources\AppIcon\appiconfg.svg" />
	  <None Remove="Resources\Splash\" />
	  <None Remove="Resources\Splash\splashicon.svg" />
	  <None Remove="Resources\Images\Authentication\fileFolder.svg" />
	  <None Remove="Resources\Images\file_folder.svg" />
	  <None Remove="Resources\Images\device.svg" />
	  <None Remove="Resources\Images\tilted_rectangle_bg.svg" />
	  <None Remove="Resources\Images\chevron_right.svg" />
	  <None Remove="Resources\Images\temp_child_services.svg" />
	  <None Remove="Resources\Images\temp_case.svg" />
	  <None Remove="Resources\Images\bc_logo_text.svg" />
