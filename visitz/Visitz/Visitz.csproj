	<ItemGroup>
	  <EmbeddedResource Update="Resources\Localization\LocalizedStrings.fr-FR.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>LocalizedStrings.fr.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Condition=" '$(EnableDefaultEmbeddedResourceItems)' == 'true' " Update="Resources\Localization\LocalizedStrings.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>LocalizedStrings.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Resources\Localization\LocalizedStrings.fr-FR.Designer.cs" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\VisitzApi\VisitzApi.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Controls\FormItemViewView.xaml.cs">
	    <DependentUpon>FormItemViewView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\CaseloadItemView.xaml.cs">
