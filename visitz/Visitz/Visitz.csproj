	  </Compile>
	  <Compile Update="VisitzApp.xaml.cs">
	    <DependentUpon>VisitzApp.xaml</DependentUpon>
	  </Compile>
	  <Compile Condition=" '$(EnableDefaultCompileItems)' == 'true' " Update="Resources\Localization\LocalizedStrings.fr.Designer.cs">
	    <DependentUpon>LocalizedStrings.fr.resx</DependentUpon>
	  </Compile>
	  <Compile Condition=" '$(EnableDefaultCompileItems)' == 'true' " Update="Resources\Localization\LocalizedStrings.Designer.cs">
	    <DependentUpon>LocalizedStrings.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	  <Compile Update="Pages\CaseloadPage.xaml.cs">
	    <DependentUpon>CaseloadPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Pages\NotesPage.xaml.cs">
	    <DependentUpon>NotesPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Pages\VisitzPage.xaml.cs">
	    <DependentUpon>VisitzPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <MauiXaml Update="Resources\Templates\ControlTemplates.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ContactItemView.xaml">
	    <Generator>MSBuild:Compile</Generator>
